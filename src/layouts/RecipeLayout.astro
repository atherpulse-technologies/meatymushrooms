---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";

export interface Props {
    title: string;
    description: string;
    cookTime: string;
    difficulty: string;
    cuisine: string;
    rating: number;
    reviews: number;
    image: any;
}

const { title, description, cookTime, difficulty, cuisine, rating, reviews, image } = Astro.props;
---

<Head title={`${title} - Meaty Mushrooms Recipe`} />

<main class="min-h-screen bg-white pt-20">
    <!-- Breadcrumb -->
    <section class="py-6 bg-gray-50">
        <div class="max-w-4xl mx-auto px-6">
            <nav class="flex items-center gap-2 text-sm text-gray-500">
                <a href="/" class="hover:text-[#3A493E]">Home</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a href="/recipes" class="hover:text-[#3A493E]">Recipes</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-[#3A493E]">{title}</span>
            </nav>
        </div>
    </section>

    <!-- Recipe Header -->
    <section class="py-12">
        <div class="max-w-4xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <span class="text-sm bg-[#E9F0EA] text-[#3A493E] px-3 py-1 rounded-full">{cuisine}</span>
                        <span class={`text-sm px-3 py-1 rounded-full ${
                            difficulty === 'Easy' ? 'bg-green-100 text-green-600' :
                            difficulty === 'Medium' ? 'bg-orange-100 text-orange-600' :
                            'bg-red-100 text-red-600'
                        }`}>{difficulty}</span>
                    </div>
                    
                    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">{title}</h1>
                    <p class="text-lg text-gray-600 mb-6">{description}</p>
                    
                    <div class="flex items-center gap-6 mb-8">
                        <div class="flex items-center gap-1 text-yellow-400">
                            {Array(rating).fill(0).map(() => (
                                <i class="fas fa-star"></i>
                            ))}
                            {Array(5 - rating).fill(0).map(() => (
                                <i class="far fa-star"></i>
                            ))}
                            <span class="text-gray-500 ml-2">({reviews} reviews)</span>
                        </div>
                        <span class="text-gray-500">•</span>
                        <span class="text-gray-600 font-medium">{cookTime}</span>
                    </div>

                    <!-- Recipe Stats -->
                    <div class="grid grid-cols-3 gap-6 p-6 bg-gray-50 rounded-2xl">
                        <div class="text-center">
                            <i class="fas fa-clock text-[#3A493E] text-xl mb-2"></i>
                            <div class="text-sm text-gray-500">Prep Time</div>
                            <div class="font-semibold">{(cookTime)}</div>
                        </div>
                        <div class="text-center">
                            <i class="fas fa-fire text-[#3A493E] text-xl mb-2"></i>
                            <div class="text-sm text-gray-500">Cook Time</div>
                            <div class="font-semibold">{(cookTime)} </div>
                        </div>
                        <div class="text-center">
                            <i class="fas fa-users text-[#3A493E] text-xl mb-2"></i>
                            <div class="text-sm text-gray-500">Serves</div>
                            <div class="font-semibold">4 people</div>
                        </div>
                    </div>
                </div>
                
                <div class="relative">
                    <img src={image} alt={title} class="w-full h-96 object-cover rounded-3xl shadow-lg" />
                    <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-[#3A493E]/10 rounded-2xl -z-10"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Recipe Content -->
    <section class="pb-20">
        <div class="max-w-4xl mx-auto px-6">
            <slot />
        </div>
    </section>
</main>

<Footer />
