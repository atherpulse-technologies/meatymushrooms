---
import { Image } from 'astro:assets';
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";

export interface Props {
    title: string;
    description: string;
    cookTime: string;
    prepTime: string;
    difficulty: string;
    cuisine: string;
    rating: number;
    reviews: number;
    servings: number;
    calories: number;
    image: ImageMetadata;
}

const { title, description, cookTime, prepTime, difficulty, cuisine, rating, reviews, servings, calories, image } = Astro.props;
---

<Head title={`${title} - Meaty Mushrooms Recipe`} />

<main class="min-h-screen bg-white">
    <!-- Recipe Header -->
    <section class="pt-24 pb-12 bg-[#F8FAF8]">
        <div class="max-w-6xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <nav class="flex items-center gap-2 text-sm text-stone-500 mb-6">
                        <a href="/" class="hover:text-[#3A493E]">Home</a>
                        <i class="fas fa-chevron-right text-xs"></i>
                        <a href="/recipes" class="hover:text-[#3A493E]">Recipes</a>
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-[#3A493E]">{title}</span>
                    </nav>
                    
                    <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4">{title}</h1>
                    <p class="text-lg text-stone-600 mb-6">{description}</p>
                    
                    <div class="flex items-center gap-6 mb-6">
                        <div class="flex items-center gap-1 text-yellow-400">
                            {Array.from({length: 5}, (_, i) => (
                                <i class={`fas fa-star ${i < rating ? '' : 'text-gray-300'}`}></i>
                            ))}
                            <span class="text-stone-600 ml-2">({reviews} reviews)</span>
                        </div>
                        <span class="text-sm bg-[#E9F0EA] text-[#3A493E] px-3 py-1 rounded-full">{cuisine}</span>
                        <span class={`text-sm px-3 py-1 rounded-full ${
                            difficulty === 'Easy' ? 'bg-green-100 text-green-600' :
                            difficulty === 'Medium' ? 'bg-orange-100 text-orange-600' :
                            'bg-red-100 text-red-600'
                        }`}>{difficulty}</span>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="text-center p-4 bg-white rounded-xl">
                            <i class="fas fa-clock text-[#3A493E] text-xl mb-2"></i>
                            <p class="text-sm text-stone-500">Prep Time</p>
                            <p class="font-semibold">{prepTime}</p>
                        </div>
                        <div class="text-center p-4 bg-white rounded-xl">
                            <i class="fas fa-fire text-[#3A493E] text-xl mb-2"></i>
                            <p class="text-sm text-stone-500">Cook Time</p>
                            <p class="font-semibold">{cookTime}</p>
                        </div>
                        <div class="text-center p-4 bg-white rounded-xl">
                            <i class="fas fa-users text-[#3A493E] text-xl mb-2"></i>
                            <p class="text-sm text-stone-500">Servings</p>
                            <p class="font-semibold">{servings}</p>
                        </div>
                        <div class="text-center p-4 bg-white rounded-xl">
                            <i class="fas fa-bolt text-[#3A493E] text-xl mb-2"></i>
                            <p class="text-sm text-stone-500">Calories</p>
                            <p class="font-semibold">{calories}</p>
                        </div>
                    </div>
                </div>

                <div class="relative">
                    <Image src={image} alt={title} class="w-full rounded-2xl shadow-lg" />
                    <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full">
                        <div class="flex items-center gap-1">
                            <i class="fas fa-heart text-red-500"></i>
                            <span class="text-sm font-medium">Save Recipe</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Recipe Content -->
    <section class="py-12">
        <div class="max-w-6xl mx-auto px-6">
            <div class="grid lg:grid-cols-3 gap-12">
                <!-- Ingredients -->
                <div class="lg:col-span-1">
                    <div class="sticky top-24">
                        <h2 class="text-2xl font-bold text-stone-900 mb-6">Ingredients</h2>
                        <div class="bg-[#F8FAF8] rounded-2xl p-6">
                            <slot name="ingredients" />
                        </div>
                    </div>
                </div>

                <!-- Instructions -->
                <div class="lg:col-span-2">
                    <h2 class="text-2xl font-bold text-stone-900 mb-6">Instructions</h2>
                    <div class="space-y-6">
                        <slot name="instructions" />
                    </div>

                    <!-- Tips & Notes -->
                    <div class="mt-12 p-6 bg-blue-50 rounded-2xl border border-blue-100">
                        <h3 class="text-lg font-semibold text-blue-900 mb-3 flex items-center gap-2">
                            <i class="fas fa-lightbulb"></i>
                            Chef's Tips & Notes
                        </h3>
                        <slot name="tips" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Related Recipes -->
    <section class="py-12 bg-[#F8FAF8]">
        <div class="max-w-6xl mx-auto px-6">
            <h2 class="text-2xl font-bold text-stone-900 mb-8 text-center">You Might Also Like</h2>
            <slot name="related-recipes" />
        </div>
    </section>
</main>

<Footer />
