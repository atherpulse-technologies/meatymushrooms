---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: string;
  keywords?: string;
}

const {
  title = "Meaty Mushrooms - Premium Organic Mushrooms from Vadakara, Kozhikode",
  description = "Meaty Mushrooms is Vadakara and Kozhikode (Calicut)'s trusted mushroom farm, offering fresh-from-Vadakara oyster mushrooms, mushroom powder, and value-added mushroom products in Kerala.",
  canonical = "https://www.meatymushrooms.in",
  image = "https://www.meatymushrooms.in/assets/images/og-image.jpg",
  type = "website",
  keywords = "mushrooms vadakara, mushrooms kozhikkode, mushrooms calicut, kerala mushrooms, meaty mushrooms, oyster mushrooms kerala, fresh mushrooms vadakara, fresh mushrooms kozhikkode, fresh mushrooms calicut, organic mushrooms kerala, mushroom farm vadakara, mushroom farm kozhikkode, mushroom farm calicut, mushroom supplier kerala, mushroom wholesale kerala, edible mushrooms kerala, oyster mushroom farm kerala, mushroom powder kerala, buy mushrooms vadakara, buy mushrooms kozhikkode, buy mushrooms calicut, fresh oyster mushrooms kerala, mushroom cultivation kerala, mushroom products kerala, mushroom achar kerala, mushroom pappadam kerala, spawn production kerala, mushroom delivery kozhikkode"
} = Astro.props;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Meaty Mushrooms",
  "url": "https://www.meatymushrooms.in",
  "logo": "https://www.meatymushrooms.in/assets/images/logo.png",
  "description": "Meaty Mushrooms is a Kerala mushroom farm based in Makkoolpeedika, Vadakara, serving Kozhikode (Calicut) with fresh-from-Vadakara oyster mushrooms and mushroom products.",
  "keywords": "mushrooms vadakara, mushrooms kozhikkode, mushrooms calicut, kerala mushrooms, oyster mushrooms kerala, fresh mushrooms kerala",
  "areaServed": ["Vadakara", "Kozhikode", "Calicut", "Kerala"],
  "telephone": "+91-80789-37260",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Keethadi Road, Makkoolpeedika",
    "addressLocality": "Vadakara",
    "addressRegion": "Kerala",
    "postalCode": "673104",
    "addressCountry": "IN"
  },
  "sameAs": [
    "https://www.facebook.com/meatymushrooms",
    "https://www.instagram.com/meatymushrooms",
    "https://www.linkedin.com/company/meatymushrooms"
  ]
};
---

<!-- Favicon Links -->
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png">
<link rel="manifest" href="/favicon/site.webmanifest">

<!-- Optimized Font Loading -->
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600&family=Pattaya&family=Manjari:wght@400;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'">
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600&family=Pattaya&family=Manjari:wght@400;700&display=swap">
</noscript>

<!-- SEO Meta Tags -->
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="index, follow">
<meta name="author" content="Meaty Mushrooms">
<meta name="keywords" content={keywords}>
<meta name="geo.region" content="IN-KL">
<meta name="geo.placename" content="Vadakara, Kozhikode, Kerala">
<meta name="ICBM" content="11.6085, 75.5917">

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={image}>
<meta property="og:site_name" content="Meaty Mushrooms">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content={canonical}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>

<!-- Canonical URL -->
<link rel="canonical" href={canonical}>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLD)}></script>

