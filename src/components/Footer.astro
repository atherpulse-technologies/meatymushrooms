    <script is:inline>
        function initAOSWhenIdle() {
            const loadAOS = () => {
                const css = document.createElement('link');
                css.rel = 'stylesheet';
                css.href = 'https://unpkg.com/aos@2.3.1/dist/aos.css';
                document.head.appendChild(css);

                const script = document.createElement('script');
                script.src = 'https://unpkg.com/aos@2.3.1/dist/aos.js';
                script.defer = true;
                script.onload = () => {
                    if (typeof window.AOS !== 'undefined') {
                        window.AOS.init({
                            duration: 900,
                            once: true,
                            easing: 'ease-out-cubic'
                        });
                    }
                };
                document.body.appendChild(script);
            };

            if ('requestIdleCallback' in window) {
                window.requestIdleCallback(loadAOS, { timeout: 1500 });
            } else {
                window.setTimeout(loadAOS, 500);
            }
        }

        window.addEventListener('load', initAOSWhenIdle);

        // Mobile Menu Toggle
        document.addEventListener('DOMContentLoaded', () => {
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');

            if (mobileMenuButton && mobileMenu) {
                mobileMenuButton.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                    const isOpen = !mobileMenu.classList.contains('hidden');
                    mobileMenuButton.setAttribute('aria-expanded', String(isOpen));
                    mobileMenuButton.setAttribute('aria-label', isOpen ? 'Close mobile menu' : 'Open mobile menu');
                    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
                    const icon = mobileMenuButton.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('fa-bars');
                        icon.classList.toggle('fa-times');
                    }
                });
            }
        });
    </script>
