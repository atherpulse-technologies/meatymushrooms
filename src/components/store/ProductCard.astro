---
import type { Product } from "../../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props as Props;
---

<article class="relative rounded-xl border border-stone-200 bg-white p-4 shadow-sm hover:shadow-md transition-all">
  <span class="absolute left-4 top-4 z-10 rounded-full bg-primary/10 px-2.5 py-0.5 text-[10px] font-bold text-primary uppercase tracking-wider">{product.form}</span>
  <a href={`/products/${product.slug}`} class="block group">
    <img class="mb-3 mt-6 h-48 w-full rounded-lg border border-stone-100 bg-white object-contain p-2 group-hover:scale-105 transition-transform duration-300" src={product.image} alt={product.name} loading="lazy" />
  </a>
  <div class="space-y-1.5 mb-3">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-base font-bold text-stone-900 leading-tight line-clamp-1">{product.name}</h3>
      <span class="shrink-0 rounded-lg bg-primary px-2 py-0.5 text-xs font-bold text-white">₹{product.price} | {product.unit}</span>
    </div>
    <p class="text-xs text-stone-500 leading-relaxed line-clamp-2">{product.shortDescription}</p>
  </div>

  <div class="flex gap-2 pt-2 border-t border-stone-100">
    <a href={`/products/${product.slug}`} class="inline-flex items-center justify-center rounded-lg border border-stone-300 bg-white px-3 py-2 text-xs font-bold text-stone-700 hover:bg-stone-100 flex-1 transition-colors">
      View Details
    </a>
    <button
      class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-xs font-bold text-white hover:bg-primary-dark flex-1 transition-colors"
      data-add-to-cart
      data-product-slug={product.slug}
      data-product-name={product.name}
      data-product-price={product.price}
      data-product-image={product.image}
      data-product-unit={product.unit}
    >
      <i class="fa-solid fa-cart-plus"></i>
      Add to Cart
    </button>
  </div>
</article>
