    <!-- AOS Library -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>



<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-chrome-192x192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/favicon/android-chrome-512x512.png">




    
    <style is:global>
        :root {
            /* Default Theme (Forest) */
            --color-primary: #3A493E;
            --color-primary-rgb: 58, 73, 62;
            --color-primary-dark: #2C3A30;
            --color-primary-light: #E9F0EA; /* Light bg */
            --color-accent: #fbbf24; /* Amber-400 */
        }

        /* Utility Classes for Dynamic Theming */
        .text-primary { color: var(--color-primary); }
        .bg-primary { background-color: var(--color-primary); }
        .bg-primary-dark { background-color: var(--color-primary-dark); }
        .bg-primary-light { background-color: var(--color-primary-light); }
        .border-primary { border-color: var(--color-primary); }
        .border-primary-light { border-color: rgba(var(--color-primary-rgb), 0.2); }
        .border-primary\/10 { border-color: rgba(var(--color-primary-rgb), 0.1); }
        .border-primary\/20 { border-color: rgba(var(--color-primary-rgb), 0.2); }
        .bg-gradient-primary { background: linear-gradient(to right, var(--color-primary), var(--color-primary-dark)); }
        .bg-gradient-primary-soft { background: linear-gradient(to bottom, var(--color-primary-light), white); }
        .hover\:bg-primary:hover { background-color: var(--color-primary); }
        .hover\:bg-primary-dark:hover { background-color: var(--color-primary-dark); }
        .hover\:text-primary:hover { color: var(--color-primary); }
        
        /* Helper for opacities using RGB var */
        .bg-primary\/10 { background-color: rgba(var(--color-primary-rgb), 0.1); }
        .bg-primary\/5 { background-color: rgba(var(--color-primary-rgb), 0.05); }
        .bg-primary\/20 { background-color: rgba(var(--color-primary-rgb), 0.2); }
        .text-primary\/70 { color: rgba(var(--color-primary-rgb), 0.7); }

        body {
            font-family: 'Inter', sans-serif;
        }
        /* Malayalam Specific Styles */
        html.lang-ml body {
            font-family: 'Manjari', sans-serif;
            font-size: 0.9em; 
            line-height: 1.6;
        }
        html.lang-ml h1, html.lang-ml h2, html.lang-ml h3, html.lang-ml h4 {
            font-family: 'Manjari', sans-serif;
            font-weight: 700;
        }
        .font-pattaya {
            font-family: 'Pattaya', sans-serif;
        }
        .font-montserrat {
            font-family: 'Montserrat', sans-serif;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
    </style>
    <script is:inline>
        function initLanguage() {
            const savedLang = localStorage.getItem('lang');
            if (savedLang === 'ml' || savedLang === null) {
                document.documentElement.classList.add('lang-ml');
                updateLanguageText(true);
                if (savedLang === null) localStorage.setItem('lang', 'ml');
            }
        }

        function toggleLanguage() {
            const isMl = document.documentElement.classList.toggle('lang-ml');
            localStorage.setItem('app_language', isMl ? 'ml' : 'en');
            updateLanguageText(isMl);
            updateToggleButtons(isMl);
        }

        function updateLanguageText(isMl) {
            document.querySelectorAll('[data-ml]').forEach(el => {
                if (!el.dataset.en) el.dataset.en = el.innerText;
                if (isMl) {
                    el.innerText = el.dataset.ml;
                } else {
                    el.innerText = el.dataset.en;
                }
            });
            document.querySelectorAll('[data-ml-placeholder]').forEach(el => {
                if (!el.dataset.enPlaceholder) el.dataset.enPlaceholder = el.placeholder;
                el.placeholder = isMl ? el.dataset.mlPlaceholder : el.dataset.enPlaceholder;
            });
        }

        function updateToggleButtons(isMl) {
             const desktopBtn = document.getElementById('lang-toggle-desktop');
             const mobileBtn = document.getElementById('lang-toggle-mobile');
             
             [desktopBtn, mobileBtn].forEach(btn => {
                 if(btn) {
                     const enSpan = btn.querySelector('.lang-en');
                     const mlSpan = btn.querySelector('.lang-ml-text');
                     if(isMl) {
                         enSpan.classList.add('opacity-50', 'font-normal');
                         enSpan.classList.remove('font-bold', 'opacity-100');
                         mlSpan.classList.add('opacity-100', 'font-bold');
                         mlSpan.classList.remove('opacity-50', 'font-normal');
                     } else {
                         enSpan.classList.add('opacity-100', 'font-bold');
                         enSpan.classList.remove('opacity-50', 'font-normal');
                         mlSpan.classList.add('opacity-50', 'font-normal');
                         mlSpan.classList.remove('opacity-100', 'font-bold');
                     }
                 }
             });
        }
        
        // --- Theme Switcher Logic ---
        const themes = {
            forest: { primary: '#3A493E', rgb: '58, 73, 62', dark: '#2C3A30', light: '#E9F0EA' },
            ocean:  { primary: '#006D77', rgb: '0, 109, 119', dark: '#004E56', light: '#E6F3F4' },
            earth:  { primary: '#B05E27', rgb: '176, 94, 39', dark: '#8A481D', light: '#F9EFE9' },
            berry:  { primary: '#8B1E3F', rgb: '139, 30, 63', dark: '#6D1530', light: '#F6E6EB' },
            spicy:  { primary: '#C04E3F', rgb: '192, 78, 63', dark: '#9A3B2E', light: '#F8EDEC' }
        };

        function setTheme(themeName) {
            const theme = themes[themeName];
            if (!theme) return;
            
            const root = document.documentElement;
            root.style.setProperty('--color-primary', theme.primary);
            root.style.setProperty('--color-primary-rgb', theme.rgb);
            root.style.setProperty('--color-primary-dark', theme.dark);
            root.style.setProperty('--color-primary-light', theme.light);
            
            localStorage.setItem('app_theme', themeName);
        }

        function initTheme() {
            const savedTheme = localStorage.getItem('app_theme') || 'forest';
            setTheme(savedTheme);
        }
        
        const savedLang = localStorage.getItem('app_language');
        const shouldBeMl = savedLang === 'ml' || savedLang === null;
        
        if (shouldBeMl) {
            document.documentElement.classList.add('lang-ml');
            if (savedLang === null) localStorage.setItem('app_language', 'ml');
        }
        
        // Run specific init logic immediately
        initTheme();

        document.addEventListener('DOMContentLoaded', () => {
             const isMl = document.documentElement.classList.contains('lang-ml');
             updateLanguageText(isMl);
             updateToggleButtons(isMl);
             
             document.getElementById('lang-toggle-desktop')?.addEventListener('click', toggleLanguage);
             document.getElementById('lang-toggle-mobile')?.addEventListener('click', toggleLanguage);
             
             // Theme Button Logic
             const themeBtn = document.getElementById('theme-toggle-btn');
             const themeMenu = document.getElementById('theme-menu');
             
             if (themeBtn && themeMenu) {
                 themeBtn.addEventListener('click', (e) => {
                     e.stopPropagation();
                     themeMenu.classList.toggle('hidden');
                 });
                 
                 document.addEventListener('click', (e) => {
                     if (!themeBtn.contains(e.target) && !themeMenu.contains(e.target)) {
                         themeMenu.classList.add('hidden');
                     }
                 });
                 
                 document.querySelectorAll('.theme-option').forEach(btn => {
                     btn.addEventListener('click', () => {
                         const theme = btn.dataset.theme;
                         setTheme(theme);
                         themeMenu.classList.add('hidden');
                     });
                 });
             }
        });
    </script>
</head>
