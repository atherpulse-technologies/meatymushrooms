---
import "../assets/css/styles.css";
import SEO from "../components/seo.astro";

---




<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <SEO />
    
    <!-- Tailwind CSS -->
    <!-- <script src="https://cdn.tailwindcss.com"></script> -->
    
    <!-- External fonts and icon styles removed for faster mobile performance -->

    
    <style is:global>
        :root {
            /* Fixed Brand Theme (Berry/Burgundy) */
            --color-primary: #8B1E3F;
            --color-primary-rgb: 139, 30, 63;
            --color-primary-dark: #6D1530;
            --color-primary-light: #F6E6EB; 
            --color-accent: #fbbf24; /* Amber-400 */
        }

        /* Utility Classes for Dynamic Theming */
        .text-primary { color: var(--color-primary); }
        .bg-primary { background-color: var(--color-primary); }
        .bg-primary-dark { background-color: var(--color-primary-dark); }
        .bg-primary-light { background-color: var(--color-primary-light); }
        .border-primary { border-color: var(--color-primary); }
        .border-primary-light { border-color: rgba(var(--color-primary-rgb), 0.2); }
        .border-primary\/10 { border-color: rgba(var(--color-primary-rgb), 0.1); }
        .border-primary\/20 { border-color: rgba(var(--color-primary-rgb), 0.2); }
        .bg-gradient-primary { background: linear-gradient(to right, var(--color-primary), var(--color-primary-dark)); }
        .bg-gradient-primary-soft { background: linear-gradient(to bottom, var(--color-primary-light), white); }
        .hover\:bg-primary:hover { background-color: var(--color-primary); }
        .hover\:bg-primary-dark:hover { background-color: var(--color-primary-dark); }
        .hover\:text-primary:hover { color: var(--color-primary); }
        
        /* Helper for opacities using RGB var */
        .bg-primary\/10 { background-color: rgba(var(--color-primary-rgb), 0.1); }
        .bg-primary\/5 { background-color: rgba(var(--color-primary-rgb), 0.05); }
        .bg-primary\/20 { background-color: rgba(var(--color-primary-rgb), 0.2); }
        .text-primary\/70 { color: rgba(var(--color-primary-rgb), 0.7); }

        body {
            font-family: 'Inter', system-ui, -apple-system, Segoe UI, sans-serif;
        }
        .font-pattaya {
            font-family: 'Pattaya', cursive;
        }
        .font-montserrat {
            font-family: 'Montserrat', system-ui, sans-serif;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-[#FFFDF9]">
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-lg border-b border-stone-200">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <!-- Logo -->
                <a href="/" class="flex flex-col items-center leading-none group">
                    <span class="font-pattaya text-4xl md:text-5xl text-primary block group-hover:scale-105 transition-transform origin-center">Meaty</span>
                    <span class="font-montserrat text-sm md:text-base font-medium text-primary -mt-1 md:-mt-1.5 block">Mushrooms</span>
                </a>

                <!-- Desktop Navigation -->
                <div class="hidden lg:flex items-center gap-6">
                    <nav class="flex items-center gap-6">
                        <a href="/" class="text-stone-600 hover:text-primary transition-colors text-sm font-medium">Home</a>
                        <a href="/#store" class="text-stone-600 hover:text-primary transition-colors text-sm font-medium">Store</a>
                        <a href="/recipes" class="text-stone-600 hover:text-primary transition-colors text-sm font-medium">Recipes</a>
                        <a href="/about" class="text-stone-600 hover:text-primary transition-colors text-sm font-medium">About</a>
                        <a href="/contact" class="text-stone-600 hover:text-primary transition-colors text-sm font-medium">Contact</a>
                    </nav>
                    <button class="relative inline-flex items-center justify-center rounded-lg border border-primary/20 bg-primary-light p-2.5 text-primary hover:bg-primary hover:text-white transition-colors" data-open-cart aria-label="Open cart">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span class="absolute -right-1.5 -top-1.5 inline-grid h-5 min-w-5 place-items-center rounded-full bg-primary px-1 text-[10px] font-bold text-white" data-cart-count>0</span>
                    </button>
                </div>

                <!-- Mobile Menu Button + Cart -->
                <div class="flex items-center gap-2 lg:hidden">
                    <button class="relative inline-flex items-center justify-center rounded-lg border border-stone-300 bg-white p-2 text-stone-700" data-open-cart aria-label="Open cart">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span class="absolute -right-1.5 -top-1.5 inline-grid h-5 min-w-5 place-items-center rounded-full bg-primary px-1 text-[10px] font-bold text-white" data-cart-count>0</span>
                    </button>
                    <button class="p-2" id="mobile-menu-button" aria-label="Open mobile menu" aria-controls="mobile-menu" aria-expanded="false">
                        <span class="text-xl text-stone-600 leading-none" aria-hidden="true">☰</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div class="hidden lg:hidden" id="mobile-menu" aria-hidden="true">
            <div class="px-6 py-5 space-y-4 bg-white border-t border-stone-200">
                <a href="/" class="block text-stone-600 hover:text-primary transition-colors text-sm font-medium">Home</a>
                <a href="/#store" class="block text-stone-600 hover:text-primary transition-colors text-sm font-medium">Store</a>
                <a href="/recipes" class="block text-stone-600 hover:text-primary transition-colors text-sm font-medium">Recipes</a>
                <a href="/about" class="block text-stone-600 hover:text-primary transition-colors text-sm font-medium">About</a>
                <a href="/contact" class="block text-stone-600 hover:text-primary transition-colors text-sm font-medium">Contact</a>
            </div>
        </div>
    </nav>
