---
import "../assets/css/styles.css";


---




<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meaty Mushrooms - Premium Organic Mushrooms from Makkool</title>
    
    <!-- Tailwind CSS -->
    <!-- <script src="https://cdn.tailwindcss.com"></script> -->
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Pattaya&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- AOS Library -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .font-pattaya {
            font-family: 'Pattaya', sans-serif;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-[#FFFDF9]">
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-lg border-b border-stone-100">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-3">
                    <div>
                        <span class="font-pattaya text-4xl text-stone-800 block leading-none">Meaty</span>
                        <span class="text-sm tracking-wide text-stone-600">MUSHROOMS</span>
                    </div>
                </a>

                <!-- Desktop Navigation -->
                <div class="hidden lg:flex items-center gap-8">
                    <a href="#about" class="text-stone-600 hover:text-stone-900 transition-colors text-sm">About</a>
                    <a href="#products" class="text-stone-600 hover:text-stone-900 transition-colors text-sm">Products</a>
                    <a href="#farm" class="text-stone-600 hover:text-stone-900 transition-colors text-sm">Our Farm</a>
                    <a href="#recipes" class="text-stone-600 hover:text-stone-900 transition-colors text-sm">Recipes</a>
                    <a href="#contact" class="text-stone-600 hover:text-stone-900 transition-colors text-sm">Contact</a>
                    <button class="px-6 py-2.5 bg-[#3A493E] text-white rounded-full hover:bg-[#2C3A30] transition-all flex items-center gap-2 text-sm">
                        <i class="fas fa-shopping-basket"></i>
                        Order Now
                    </button>
                </div>

                <!-- Mobile Menu Button -->
                <button class="lg:hidden" id="mobile-menu-button">
                    <i class="fas fa-bars text-xl text-stone-600"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div class="hidden lg:hidden" id="mobile-menu">
            <div class="px-6 py-6 space-y-4 bg-white border-t border-stone-100">
                <a href="#about" class="block text-stone-600 hover:text-stone-900 transition-colors">About</a>
                <a href="#products" class="block text-stone-600 hover:text-stone-900 transition-colors">Products</a>
                <a href="#farm" class="block text-stone-600 hover:text-stone-900 transition-colors">Our Farm</a>
                <a href="#recipes" class="block text-stone-600 hover:text-stone-900 transition-colors">Recipes</a>
                <a href="#contact" class="block text-stone-600 hover:text-stone-900 transition-colors">Contact</a>
                <button class="w-full px-6 py-3 bg-[#3A493E] text-white rounded-full hover:bg-[#2C3A30] transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-shopping-basket"></i>
                    Order Now
                </button>
            </div>
        </div>
    </nav>
