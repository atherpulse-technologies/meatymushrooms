---
import "../assets/css/styles.css";
import SEO from "../components/seo.astro";

---




<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <SEO />
    
    <!-- Tailwind CSS -->
    <!-- <script src="https://cdn.tailwindcss.com"></script> -->
    
    <!-- External fonts and icon styles removed for faster mobile performance -->

    
    <style is:global>
        :root {
            /* Fixed Brand Theme (Berry/Burgundy) */
            --color-primary: #8B1E3F;
            --color-primary-rgb: 139, 30, 63;
            --color-primary-dark: #6D1530;
            --color-primary-light: #F6E6EB; 
            --color-accent: #fbbf24; /* Amber-400 */
        }

        /* Utility Classes for Dynamic Theming */
        .text-primary { color: var(--color-primary); }
        .bg-primary { background-color: var(--color-primary); }
        .bg-primary-dark { background-color: var(--color-primary-dark); }
        .bg-primary-light { background-color: var(--color-primary-light); }
        .border-primary { border-color: var(--color-primary); }
        .border-primary-light { border-color: rgba(var(--color-primary-rgb), 0.2); }
        .border-primary\/10 { border-color: rgba(var(--color-primary-rgb), 0.1); }
        .border-primary\/20 { border-color: rgba(var(--color-primary-rgb), 0.2); }
        .bg-gradient-primary { background: linear-gradient(to right, var(--color-primary), var(--color-primary-dark)); }
        .bg-gradient-primary-soft { background: linear-gradient(to bottom, var(--color-primary-light), white); }
        .hover\:bg-primary:hover { background-color: var(--color-primary); }
        .hover\:bg-primary-dark:hover { background-color: var(--color-primary-dark); }
        .hover\:text-primary:hover { color: var(--color-primary); }
        
        /* Helper for opacities using RGB var */
        .bg-primary\/10 { background-color: rgba(var(--color-primary-rgb), 0.1); }
        .bg-primary\/5 { background-color: rgba(var(--color-primary-rgb), 0.05); }
        .bg-primary\/20 { background-color: rgba(var(--color-primary-rgb), 0.2); }
        .text-primary\/70 { color: rgba(var(--color-primary-rgb), 0.7); }

        body {
            font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        }
        /* Malayalam Specific Styles */
        html.lang-ml body {
            font-family: system-ui, -apple-system, Segoe UI, sans-serif;
            font-size: 0.9em; 
            line-height: 1.6;
        }
        html.lang-ml h1, html.lang-ml h2, html.lang-ml h3, html.lang-ml h4 {
            font-family: system-ui, -apple-system, Segoe UI, sans-serif;
            font-weight: 700;
        }
        .font-pattaya {
            font-family: inherit;
        }
        .font-montserrat {
            font-family: inherit;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
    </style>
    <script is:inline>
        function updateLanguageText(isMl) {
            if (isMl) {
                document.querySelectorAll('[data-ml]').forEach(el => {
                    if (!el.dataset.en) el.dataset.en = el.textContent;
                    el.textContent = el.dataset.ml;
                });
                document.querySelectorAll('[data-ml-placeholder]').forEach(el => {
                    if (!el.dataset.enPlaceholder) el.dataset.enPlaceholder = el.placeholder;
                    el.placeholder = el.dataset.mlPlaceholder;
                });
                return;
            }

            document.querySelectorAll('[data-ml][data-en]').forEach(el => {
                el.textContent = el.dataset.en;
            });
            document.querySelectorAll('[data-ml-placeholder][data-en-placeholder]').forEach(el => {
                el.placeholder = el.dataset.enPlaceholder;
            });
        }

        function updateToggleButtons(isMl) {
            const desktopBtn = document.getElementById('lang-toggle-desktop');
            const mobileBtn = document.getElementById('lang-toggle-mobile');

            [desktopBtn, mobileBtn].forEach(btn => {
                if (!btn) return;
                const enSpan = btn.querySelector('.lang-en');
                const mlSpan = btn.querySelector('.lang-ml-text');
                if (isMl) {
                    enSpan.classList.add('opacity-50', 'font-normal');
                    enSpan.classList.remove('font-bold', 'opacity-100');
                    mlSpan.classList.add('opacity-100', 'font-bold');
                    mlSpan.classList.remove('opacity-50', 'font-normal');
                } else {
                    enSpan.classList.add('opacity-100', 'font-bold');
                    enSpan.classList.remove('opacity-50', 'font-normal');
                    mlSpan.classList.add('opacity-50', 'font-normal');
                    mlSpan.classList.remove('opacity-100', 'font-bold');
                }
            });
        }

        function toggleLanguage() {
            const isMl = !document.documentElement.classList.contains('lang-ml');
            document.documentElement.classList.toggle('lang-ml', isMl);
            localStorage.setItem('app_language', isMl ? 'ml' : 'en');
            updateLanguageText(isMl);
            updateToggleButtons(isMl);
        }

        const savedLang = localStorage.getItem('app_language');
        const shouldBeMl = savedLang === 'ml';

        if (shouldBeMl) {
            document.documentElement.classList.add('lang-ml');
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (shouldBeMl) {
                updateLanguageText(true);
            }
            updateToggleButtons(shouldBeMl);

            document.getElementById('lang-toggle-desktop')?.addEventListener('click', toggleLanguage);
            document.getElementById('lang-toggle-mobile')?.addEventListener('click', toggleLanguage);
        });
    </script>
</head>
