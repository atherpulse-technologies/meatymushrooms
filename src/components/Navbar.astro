---
import { Image } from 'astro:assets';
import "../assets/css/styles.css";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";

import image1 from '../assets/images/image1.webp';
import banner from '../assets/images/banner.jpg';
import image2 from '../assets/images/image2.webp';  
import buttonmush from '../assets/images/button.jpg';
import oyster from '../assets/images/oyster.jpg';
import pink from '../assets/images/pink.jpg';
---

<Head/>

<!-- Navigation Bar -->
<nav class="fixed top-0 w-full bg-white/95 backdrop-blur-sm border-b border-stone-200 z-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between h-16">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-2 group">
                <div class="w-10 h-10 bg-[#3A493E] rounded-xl flex items-center justify-center group-hover:scale-105 transition-transform">
                    <span class="text-white text-lg font-bold">🍄</span>
                </div>
                <div class="leading-none">
                    <h1 class="text-lg font-bold text-stone-900 leading-tight">Meaty</h1>
                    <h1 class="text-lg font-bold text-stone-900 leading-tight -mt-1">Mushrooms</h1>
                    <p class="text-xs text-[#3A493E] leading-none -mt-0.5">Fresh from Vadakara</p>
                </div>
            </a>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex items-center gap-6">
                <a href="/" class="text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Home</a>
                <a href="/products" class="text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Products</a>
                <a href="/recipes" class="text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Recipes</a>
                <a href="/farm" class="text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Our Farm</a>
                <a href="#nutrition" class="text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Nutrition</a>
                <a href="#contact" class="text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Contact</a>
            </div>

            <!-- CTA Button -->
            <div class="hidden md:block">
                <a href="tel:+918078937260" class="bg-[#3A493E] text-white px-5 py-2.5 rounded-full hover:bg-[#2C3A30] transition-all flex items-center gap-2 text-sm font-medium">
                    <i class="fas fa-phone text-xs"></i>
                    Order Now
                </a>
            </div>

            <!-- Mobile Menu Button -->
            <button class="md:hidden p-2 text-stone-700 hover:text-[#3A493E]" id="mobile-menu-btn">
                <i class="fas fa-bars text-lg"></i>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div class="md:hidden hidden" id="mobile-menu">
            <div class="py-3 space-y-3 border-t border-stone-200">
                <a href="/" class="block text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Home</a>
                <a href="/products" class="block text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Products</a>
                <a href="/recipes" class="block text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Recipes</a>
                <a href="/farm" class="block text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Our Farm</a>
                <a href="#nutrition" class="block text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Nutrition</a>
                <a href="#contact" class="block text-stone-700 hover:text-[#3A493E] transition-colors font-medium text-sm">Contact</a>
                <a href="tel:+918078937260" class="block bg-[#3A493E] text-white px-5 py-2.5 rounded-full text-center text-sm font-medium mt-3">Order Now</a>
            </div>
        </div>
    </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn?.addEventListener('click', function() {
            mobileMenu?.classList.toggle('hidden');
        });
    });
</script>

<!-- Product Welcome Section (New QR Code focused) -->
<section class="min-h-screen pt-28 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1586075010923-2dd4570fb338?q=80&w=2000&auto=format&fit=crop&ixlib=rb-4.0.3&blur=100')] opacity-5 z-0"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="text-center lg:text-left" data-aos="fade-right">
                <span class="inline-block px-4 py-2 rounded-full bg-[#E9F0EA] text-[#3A493E] text-sm font-medium mb-6">
                    🍄 Welcome to Your Mushroom Guide
                </span>
                <h1 class="text-4xl md:text-6xl font-bold text-stone-900 leading-tight mb-6">
                    Fresh Mushrooms, <br>
                    Harvested Daily from 
                    <span class="text-[#3A493E]">Vadakara</span>
                </h1>
                <p class="text-lg text-stone-600 mb-8 max-w-xl mx-auto lg:mx-0">
                    From cooking tips to nutritional benefits - your complete guide to making the most of your premium organic mushrooms.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="#cooking-videos" class="px-8 py-4 bg-[#3A493E] text-white rounded-full hover:bg-[#2C3A30] transition-all flex items-center justify-center gap-2 group">
                        Watch Cooking Videos
                        <i class="fas fa-play text-sm"></i>
                    </a>
                    <a href="#recipes" class="px-8 py-4 border-2 border-[#3A493E] text-[#3A493E] rounded-full hover:bg-[#E9F0EA] transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-book-open"></i>
                        View Recipes
                    </a>
                </div>

                <!-- Trust Badges -->
                <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-2xl mx-auto lg:mx-0">
                    <div class="text-center" data-aos="fade-up" data-aos-delay="100">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">100%</h3>
                        <p class="text-sm text-stone-600">Organic</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="200">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">50kg+</h3>
                        <p class="text-sm text-stone-600">Daily Harvest</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="300">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">1000+</h3>
                        <p class="text-sm text-stone-600">Happy Customers</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="400">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">5+</h3>
                        <p class="text-sm text-stone-600">Varieties</p>
                    </div>
                </div>
            </div>

            <div class="relative" data-aos="fade-left">
                <Image src={image1} alt="Fresh Oyster Mushrooms" class="w-full max-w-2xl mx-auto animate-float" />
                <div class="absolute top-10 right-10 w-20 h-20 bg-[#E9F0EA] rounded-full -z-10"></div>
                <div class="absolute bottom-10 left-10 w-32 h-32 bg-[#E9F0EA] rounded-full -z-10"></div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Navigation (New) -->
<section class="py-12 bg-[#F8FAF8]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <a href="#cooking-videos" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-video text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900">Cooking Videos</h3>
            </a>
            <a href="#recipes" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-utensils text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900">Recipes</h3>
            </a>
            <a href="#nutrition" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-leaf text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900">Nutrition Facts</h3>
            </a>
            <a href="#safety" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-shield-alt text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900">Food Safety</h3>
            </a>
        </div>
    </div>
</section>

<!-- Cooking Videos Section (New) -->
<section id="cooking-videos" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-[#3A493E] tracking-wider uppercase block mb-3">Learn to Cook</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Cooking Videos & Tutorials</h2>
            <p class="text-stone-600">Master the art of cooking mushrooms with our expert video guides.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Video 1 -->
            <div class="bg-[#F8FAF8] rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-aos="fade-up">
                <div class="relative">
                    <img src="https://img.youtube.com/vi/dQw4w9WgXcQ/maxresdefault.jpg" alt="Basic Mushroom Stir Fry" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <i class="fas fa-play text-white text-3xl"></i>
                    </div>
                    <span class="absolute top-4 left-4 bg-red-600 text-white text-xs px-2 py-1 rounded">5:30</span>
                </div>
                <div class="p-6">
                    <h3 class="text-lg font-semibold text-stone-900 mb-2">Basic Mushroom Stir Fry</h3>
                    <p class="text-stone-600 text-sm mb-4">Learn the fundamentals of cooking oyster mushrooms with this simple stir-fry recipe.</p>
                    <a href="https://youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors">
                        Watch on YouTube
                        <i class="fas fa-external-link-alt text-sm"></i>
                    </a>
                </div>
            </div>

            <!-- Video 2 -->
            <div class="bg-[#F8FAF8] rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-aos="fade-up" data-aos-delay="100">
                <div class="relative">
                    <img src="https://img.youtube.com/vi/dQw4w9WgXcQ/maxresdefault.jpg" alt="Mushroom Curry Recipe" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <i class="fas fa-play text-white text-3xl"></i>
                    </div>
                    <span class="absolute top-4 left-4 bg-red-600 text-white text-xs px-2 py-1 rounded">8:45</span>
                </div>
                <div class="p-6">
                    <h3 class="text-lg font-semibold text-stone-900 mb-2">Traditional Mushroom Curry</h3>
                    <p class="text-stone-600 text-sm mb-4">Authentic Kerala-style mushroom curry with coconut and spices.</p>
                    <a href="https://youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors">
                        Watch on YouTube
                        <i class="fas fa-external-link-alt text-sm"></i>
                    </a>
                </div>
            </div>

            <!-- Video 3 -->
            <div class="bg-[#F8FAF8] rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-aos="fade-up" data-aos-delay="200">
                <div class="relative">
                    <img src="https://img.youtube.com/vi/dQw4w9WgXcQ/maxresdefault.jpg" alt="Grilled Mushrooms" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <i class="fas fa-play text-white text-3xl"></i>
                    </div>
                    <span class="absolute top-4 left-4 bg-red-600 text-white text-xs px-2 py-1 rounded">6:20</span>
                </div>
                <div class="p-6">
                    <h3 class="text-lg font-semibold text-stone-900 mb-2">Perfect Grilled Mushrooms</h3>
                    <p class="text-stone-600 text-sm mb-4">Master the art of grilling mushrooms for maximum flavor and texture.</p>
                    <a href="https://youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors">
                        Watch on YouTube
                        <i class="fas fa-external-link-alt text-sm"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="text-center mt-12">
            <a href="/cooking-videos" class="inline-flex items-center gap-2 px-8 py-4 bg-[#3A493E] text-white rounded-full hover:bg-[#2C3A30] transition-all group">
                View All Cooking Videos
                <i class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- Recipes Section (New) -->
<section id="recipes" class="py-20 bg-[#F8FAF8]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-[#3A493E] tracking-wider uppercase block mb-3">Recipe Collection</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Delicious Mushroom Recipes</h2>
            <p class="text-stone-600">Explore our curated collection of mushroom recipes from around the world.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Recipe 1 -->
            <div class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-aos="fade-up">
                <div class="relative">
                    <Image src={oyster} alt="Mushroom Biryani" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                    <div class="absolute top-4 right-4 bg-white/90 px-3 py-1 rounded-full text-sm font-medium text-[#3A493E]">
                        <i class="fas fa-clock text-xs mr-1"></i>
                        45 min
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex items-center gap-4 mb-3">
                        <span class="text-xs bg-[#E9F0EA] text-[#3A493E] px-2 py-1 rounded-full">Indian</span>
                        <span class="text-xs bg-orange-100 text-orange-600 px-2 py-1 rounded-full">Medium</span>
                    </div>
                    <h3 class="text-lg font-semibold text-stone-900 mb-2">Mushroom Biryani</h3>
                    <p class="text-stone-600 text-sm mb-4">Aromatic basmati rice cooked with tender mushrooms and traditional spices.</p>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1 text-yellow-400 text-sm">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <span class="text-stone-500 ml-1">(24)</span>
                        </div>
                        <a href="/recipe/mushroom-biryani" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors">
                            View Recipe
                            <i class="fas fa-arrow-right text-sm"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Recipe 2 -->
            <div class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-aos="fade-up" data-aos-delay="100">
                <div class="relative">
                    <Image src={pink} alt="Mushroom Soup" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                    <div class="absolute top-4 right-4 bg-white/90 px-3 py-1 rounded-full text-sm font-medium text-[#3A493E]">
                        <i class="fas fa-clock text-xs mr-1"></i>
                        25 min
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex items-center gap-4 mb-3">
                        <span class="text-xs bg-[#E9F0EA] text-[#3A493E] px-2 py-1 rounded-full">Continental</span>
                        <span class="text-xs bg-green-100 text-green-600 px-2 py-1 rounded-full">Easy</span>
                    </div>
                    <h3 class="text-lg font-semibold text-stone-900 mb-2">Creamy Mushroom Soup</h3>
                    <p class="text-stone-600 text-sm mb-4">Rich and creamy soup perfect for cold evenings with fresh herbs.</p>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1 text-yellow-400 text-sm">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="far fa-star"></i>
                            <span class="text-stone-500 ml-1">(18)</span>
                        </div>
                        <a href="/recipe/mushroom-soup" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors">
                            View Recipe
                            <i class="fas fa-arrow-right text-sm"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Recipe 3 -->
            <div class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-aos="fade-up" data-aos-delay="200">
                <div class="relative">
                    <Image src={buttonmush} alt="Mushroom Stir Fry" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                    <div class="absolute top-4 right-4 bg-white/90 px-3 py-1 rounded-full text-sm font-medium text-[#3A493E]">
                        <i class="fas fa-clock text-xs mr-1"></i>
                        15 min
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex items-center gap-4 mb-3">
                        <span class="text-xs bg-[#E9F0EA] text-[#3A493E] px-2 py-1 rounded-full">Asian</span>
                        <span class="text-xs bg-green-100 text-green-600 px-2 py-1 rounded-full">Easy</span>
                    </div>
                    <h3 class="text-lg font-semibold text-stone-900 mb-2">Quick Mushroom Stir Fry</h3>
                    <p class="text-stone-600 text-sm mb-4">Fast and healthy stir-fry with colorful vegetables and savory sauce.</p>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1 text-yellow-400 text-sm">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <span class="text-stone-500 ml-1">(31)</span>
                        </div>
                        <a href="/recipe/mushroom-stir-fry" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors">
                            View Recipe
                            <i class="fas fa-arrow-right text-sm"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-12">
            <a href="/recipes" class="inline-flex items-center gap-2 px-8 py-4 bg-[#3A493E] text-white rounded-full hover:bg-[#2C3A30] transition-all group">
                View All Recipes
                <i class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- Featured Products Section (Moved below recipes) -->
<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <!-- Section Header -->
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-[#3A493E] tracking-wider uppercase block mb-3">Our Products</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Premium Mushroom Varieties</h2>
            <p class="text-stone-600">Discover our range of premium organic mushrooms, harvested daily to ensure maximum freshness and nutrition.</p>
        </div>

        <!-- Products Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Product Card 1 -->
            <div class="bg-white rounded-2xl p-6 group hover:shadow-xl transition-all duration-300 border border-stone-100" data-aos="fade-up" data-aos-delay="0">
                <div class="relative mb-6 overflow-hidden rounded-xl">
                    <Image src={oyster} alt="Pearl Oyster Mushrooms" class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300" />
                    <span class="absolute top-4 right-4 bg-[#3A493E] text-white text-sm px-3 py-1 rounded-full">Best Seller</span>
                </div>
                <h3 class="text-xl font-semibold text-stone-900 mb-2">Pearl Oyster Mushrooms</h3>
                <p class="text-stone-600 text-sm mb-4">Fresh, tender, and perfect for stir-fries and curries. Rich in proteins and minerals.</p>
                <div class="flex items-center justify-between">
                    <span class="text-[#3A493E] font-semibold">₹60/250g</span>
                    <button class="px-4 py-2 bg-[#E9F0EA] text-[#3A493E] rounded-full hover:bg-[#3A493E] hover:text-white transition-all flex items-center gap-2 text-sm">
                        <i class="fas fa-shopping-basket"></i>
                        Add to Cart
                    </button>
                </div>
            </div>

            <!-- Product Card 2 -->
            <div class="bg-white rounded-2xl p-6 group hover:shadow-xl transition-all duration-300 border border-stone-100" data-aos="fade-up" data-aos-delay="100">
                <div class="relative mb-6 overflow-hidden rounded-xl">
                    <Image src={pink} alt="Pink Oyster Mushrooms" class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300" />
                    <span class="absolute top-4 right-4 bg-[#D87D88] text-white text-sm px-3 py-1 rounded-full">New</span>
                </div>
                <h3 class="text-xl font-semibold text-stone-900 mb-2">Pink Oyster Mushrooms</h3>
                <p class="text-stone-600 text-sm mb-4">Visually stunning with a delicate seafood-like flavor. Perfect for gourmet dishes.</p>
                <div class="flex items-center justify-between">
                    <span class="text-[#3A493E] font-semibold">₹80/250g</span>
                    <button class="px-4 py-2 bg-[#E9F0EA] text-[#3A493E] rounded-full hover:bg-[#3A493E] hover:text-white transition-all flex items-center gap-2 text-sm">
                        <i class="fas fa-shopping-basket"></i>
                        Add to Cart
                    </button>
                </div>
            </div>

            <!-- Product Card 3 -->
