---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
---

<Head title="Mushroom Recipes - Coming Soon | Meaty Mushrooms" />

<main class="min-h-screen bg-white pt-20">
    <section class="py-24 bg-stone-50">
        <div class="max-w-3xl mx-auto px-6 text-center">
            <span class="inline-block px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6">
                Coming Soon
            </span>
            <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-6">
                Mushroom Recipes
            </h1>
            <p class="text-xl text-stone-600 mb-8 max-w-2xl mx-auto">
                We're preparing authentic mushroom recipes from our kitchen in Vadakara. 
                Simple, delicious recipes that make the most of fresh oyster mushrooms.
            </p>
            
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-stone-200 max-w-md mx-auto mb-12">
                <h3 class="text-lg font-bold text-stone-900 mb-3">Get notified when recipes are live</h3>
                <p class="text-sm text-stone-600 mb-4">Be the first to receive new recipes and cooking tips.</p>
                <form class="flex gap-3">
                    <input type="email" placeholder="Your email address" 
                           class="flex-1 px-4 py-3 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                    <button class="px-5 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium whitespace-nowrap">
                        Notify Me
                    </button>
                </form>
            </div>

            <div class="mt-12">
                <p class="text-stone-500 text-sm mb-4">In the meantime, watch our cooking videos:</p>
                <a href="/cooking-videos" class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 text-white rounded-full hover:bg-red-700 transition-all font-medium">
                    <i class="fab fa-youtube"></i>
                    Watch on YouTube
                </a>
            </div>
        </div>
    </section>
</main>

<Footer />
