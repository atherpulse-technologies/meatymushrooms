        image: biryani,
        cookTime: '45 min',
        difficulty: 'Medium',
        cuisine: 'Indian',
        rating: 5,
        reviews: 24,
        category: 'Main Course',
        categoryML: 'മെയിൻ കോഴ്സ്',
        ingredients: ['Basmati Rice', 'Fresh Mushrooms', 'Onions', 'Yogurt', 'Biryani Spices', 'Ghee', 'Fresh Herbs'],
        calories: 320
    },
    {
        id: 2,
        name: 'Creamy Mushroom Soup',
        nameML: 'ക്രീമി മഷ്റൂം സൂപ്പ്',
        description: 'Rich and creamy soup perfect for cold evenings with fresh herbs. Comfort food at its finest.',
        descriptionML: 'നല്ല കട്ടിയുള്ള ക്രീമി സൂപ്പ്. വൈകുന്നേരങ്ങളിൽ കഴിക്കാൻ ഉത്തമം.',
        image: soup,
        cookTime: '25 min',
        difficulty: 'Easy',
        cuisine: 'Continental',
        rating: 4,
        reviews: 18,
        category: 'Soup',
        categoryML: 'സൂപ്പ്',
        ingredients: ['Fresh Mushrooms', 'Heavy Cream', 'Onions', 'Garlic', 'Vegetable Stock', 'Thyme', 'Butter', 'Black Pepper'],
        calories: 180
    },
    {
        id: 3,
        name: 'Quick Mushroom Stir Fry',
        nameML: 'മഷ്റൂം സ്റ്റിർ ഫ്രൈ',
        description: 'Fast and healthy stir-fry with colorful vegetables and savory sauce. Perfect for busy weeknights.',
        descriptionML: 'പച്ചക്കറികളും കൂണും ചേർത്തുള്ള വേഗത്തിൽ തയ്യാറാക്കാവുന്ന വിഭവം.',
