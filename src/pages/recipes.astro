const categories = ['All', 'Main Course', 'Soup', 'Quick Meal', 'Appetizer', 'Side Dish'];
---

<Head title="Mushroom Recipes - Simple & Delicious Cooking Ideas" />

<main class="min-h-screen bg-white pt-20">
    <!-- Hero Section -->
    <section class="py-20 bg-stone-50">
        <div class="max-w-6xl mx-auto px-6 text-center">
            <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">
                <span data-ml="ലളിതമായ">Simple</span><br>
                <span class="text-primary" data-ml="കൂൺ വിഭവങ്ങൾ">Mushroom Recipes</span>
            </h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-12" data-ml="ഫ്രഷ് കൂൺ കൊണ്ട് എളുപ്പത്തിൽ തയ്യാറാക്കാവുന്ന രുചികരമായ വിഭവങ്ങൾ.">
                Easy-to-follow recipes that turn fresh mushrooms into extraordinary meals. 
                Perfect for home cooks of all skill levels.
            </p>
            
            <!-- Search Bar -->
            <div class="max-w-md mx-auto mb-8">
                <div class="relative">
                    <input type="text" placeholder="Search recipes..." 
                           class="w-full px-6 py-4 pl-12 border border-gray-200 rounded-full focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                    <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="grid grid-cols-3 gap-8 max-w-md mx-auto">
                <div class="text-center">
                    <div class="text-2xl font-bold text-primary mb-1">15+</div>
                    <div class="text-sm text-gray-600" data-ml="റെസിപ്പികൾ">Recipes</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-primary mb-1">5-45</div>
                    <div class="text-sm text-gray-600" data-ml="മിനിറ്റ്">Minutes</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-primary mb-1">4.8★</div>
                    <div class="text-sm text-gray-600" data-ml="റേറ്റിംഗ്">Avg Rating</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Filter Section -->
    <section class="py-8 bg-white border-b">
        <div class="max-w-6xl mx-auto px-6">
            <div class="flex flex-wrap items-center justify-center gap-3">
                {categories.map(category => (
                    <button class="category-btn px-6 py-2 rounded-full border border-gray-200 text-gray-600 hover:border-primary hover:text-primary transition-all font-medium">
                        {category}
                    </button>
                ))}
            </div>
        </div>
    </section>

    <!-- Recipes Grid -->
    <section class="py-20">
        <div class="max-w-6xl mx-auto px-6">
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
                {recipes.map((recipe) => (
                    <article class="group">
                        <a href={`/recipes/recipe-${recipe.id}`} class="block">
                            <div class="relative mb-6 overflow-hidden rounded-2xl">
                                <Image src={recipe.image} alt={recipe.name} 
                                       class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500" />
                                <div class="absolute top-4 left-4">
                                    <span class="bg-white/90 backdrop-blur-sm text-gray-700 px-3 py-1 rounded-full text-sm font-medium" data-ml={recipe.categoryML}>
                                        {recipe.category}
                                    </span>
                                </div>
                                <div class="absolute top-4 right-4">
                                    <button class="w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-white transition-colors">
                                        <i class="far fa-heart text-gray-600"></i>
                                    </button>
                                </div>
                            </div>
                            
                            <div class="space-y-3">
                                <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors" data-ml={recipe.nameML}>
                                    {recipe.name}
                                </h3>
                                <p class="text-gray-600 leading-relaxed" data-ml={recipe.descriptionML}>{recipe.description}</p>
                                
                                <!-- Recipe Meta -->
                                <div class="flex items-center justify-between text-sm text-gray-500 mb-3">
                                    <div class="flex items-center gap-4">
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-clock"></i>
                                            {recipe.cookTime}
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-utensils"></i>
                                            {recipe.ingredients.length} ingredients
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-1 text-yellow-400">
                                        {Array(recipe.rating).fill(0).map(() => (
                                            <i class="fas fa-star text-xs"></i>
                                        ))}
                                    </div>
                                </div>

                                <!-- Ingredients List -->
                                <div class="mb-4">
                                    <h4 class="text-sm font-semibold text-gray-700 mb-2">Ingredients:</h4>
                                    <ul class="text-sm text-gray-600 space-y-1">
                                        {recipe.ingredients.map(ingredient => (
                                            <li class="flex items-center gap-2">
                                                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                                                {ingredient}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                                
                                <!-- Difficulty Badge -->
                                <div class="flex items-center justify-between">
                                    <span class={`text-xs px-3 py-1 rounded-full ${
                                        recipe.difficulty === 'Easy' ? 'bg-green-100 text-green-600' :
                                        recipe.difficulty === 'Medium' ? 'bg-orange-100 text-orange-600' :
                                        'bg-red-100 text-red-600'
                                    }`}>{recipe.difficulty}</span>
                                    <span class="text-sm text-gray-500">{recipe.calories} cal</span>
                                </div>
                            </div>
                        </a>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="py-20 bg-stone-50">
        <div class="max-w-2xl mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold text-gray-900 mb-4" data-ml="എല്ലാ റെസിപ്പികളും ലഭിക്കാൻ">Never Miss a Recipe</h2>
            <p class="text-gray-600 mb-8" data-ml="ഏറ്റവും പുതിയ റെസിപ്പികളും പാചക കുറിപ്പുകളും ഇമെയിലിലൂടെ നേടൂ.">Get our latest mushroom recipes and cooking tips delivered to your inbox.</p>
            <form class="flex gap-4 max-w-md mx-auto">
                <input type="email" placeholder="Enter your email" 
                       class="flex-1 px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary">
                <button class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors font-medium" data-ml="സബ്സ്ക്രൈബ്">
                    Subscribe
                </button>
            </form>
        </div>
    </section>
</main>

<Footer />

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterButtons = document.querySelectorAll('.category-btn');
        
        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Remove active state from all buttons
                filterButtons.forEach(btn => {
                    btn.classList.remove('border-primary', 'text-primary', 'bg-primary', 'text-white');
                    btn.classList.add('border-gray-200', 'text-gray-600');
                });
                
                // Add active state to clicked button
                this.classList.remove('border-gray-200', 'text-gray-600');
                this.classList.add('border-primary', 'bg-primary', 'text-white');
            });
        });
        
        // Set initial active state
        filterButtons[0].classList.add('border-primary', 'bg-primary', 'text-white');
        filterButtons[0].classList.remove('border-gray-200', 'text-gray-600');
    });
</script>
