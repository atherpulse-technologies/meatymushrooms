---
import { Image } from 'astro:assets';
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import oyster from '../assets/images/oyster.jpg';
import pink from '../assets/images/pink.jpg';
import buttonmush from '../assets/images/button.jpg';

const products = [
    {
        id: 'elm-oyster-mushrooms',
        name: 'Elm Oyster Mushrooms',
        description: 'Known as the "Meaty Mushroom". Superior 23-39% protein content, firm texture that holds shape, and rich in amino acids.',
        image: oyster,
        price: '₹80/200g',
        category: 'Fresh Mushrooms',
        features: ['High Protein', 'Meaty Texture', 'Vitamin D Rich', 'Fresh Daily'],
        availability: 'In Stock',
        nutritionHighlights: ['23-39% Protein', 'Low Calorie', 'Rich in Beta-Glucans']
    },
    {
        id: 'pink-oyster-mushrooms',
        name: 'Pink Oyster Mushrooms',
        description: 'Visually stunning pink mushrooms with delicate seafood-like flavor. Perfect for gourmet cooking.',
        image: pink,
        price: '₹80/150g',
        category: 'Fresh Mushrooms',
        features: ['Gourmet Quality', 'Unique Flavor', 'Antioxidant Rich', 'Premium Grade'],
        availability: 'Future product',
        nutritionHighlights: ['High antioxidants', 'Unique pink color', 'Delicate taste']
    },
    {
        id: 'mushroom-powder',
        name: 'Mushroom Powder',
        description: '100% pure mushroom powder made from dehydrated oyster mushrooms. Perfect for soups, smoothies, and seasoning.',
        image: buttonmush,
        price: '₹200/100g',
        category: 'Processed Products',
        features: ['100% Pure', 'Long Shelf Life', 'Concentrated Nutrition', 'Versatile Use'],
        availability: 'Future product',
        nutritionHighlights: ['Concentrated nutrients', '12-month shelf life', 'No additives']
    },
    {
        id: 'mushroom-achar',
        name: 'Mushroom Pickle (Achar)',
        description: 'Traditional Kerala-style mushroom pickle with authentic spices. Tangy, spicy, and full of flavor.',
        image: oyster,
        price: '₹150/250g',
        category: 'Ready to Eat',
        features: ['Authentic Recipe', 'Homemade Style', 'No Preservatives', 'Traditional Spices'],
        availability: 'Future product',
        nutritionHighlights: ['Rich in probiotics', 'Traditional spices', 'Homemade quality']
    },
    {
        id: 'mushroom-biscuits',
        name: 'Mushroom Biscuits',
        description: 'Healthy, crunchy biscuits made with mushroom powder. Perfect snack for kids and adults.',
        image: buttonmush,
        price: '₹80/200g',
        category: 'Snacks',
        features: ['Healthy Snack', 'Kids Favorite', 'Baked Not Fried', 'No Artificial Colors'],
        availability: 'Future product',
        nutritionHighlights: ['Added nutrition', 'Low sugar', 'Whole grain']
    },
    {
        id: 'mushroom-biryani-mix',
        name: 'Mushroom Biryani Mix',
        description: 'Ready-to-cook biryani mix with fresh mushrooms and aromatic spices. Just add rice and cook.',
        image: pink,
        price: '₹200/500g',
        category: 'Ready to Cook',
        features: ['Ready in 30 mins', 'Authentic Spices', 'Fresh Mushrooms', 'Family Size'],
        availability: 'Future product',
        nutritionHighlights: ['Complete meal', 'Balanced nutrition', 'Authentic taste']
    },
    {
        id: 'mushroom-papad',
        name: 'Mushroom Papad',
        description: 'Crispy mushroom papads made with mushroom flour. Traditional taste with added nutrition.',
        image: oyster,
        price: '₹60/100g',
        category: 'Traditional',
        features: ['Handmade', 'Sun Dried', 'No Chemicals', 'Crispy Texture'],
        availability: 'Future product',
        nutritionHighlights: ['High fiber', 'Traditional method', 'Added protein']
    },
    {
        id: 'mushroom-curry-paste',
        name: 'Mushroom Curry Paste',
        description: 'Concentrated curry paste with mushrooms and spices. Just add water or coconut milk.',
        image: buttonmush,
        price: '₹100/200g',
        category: 'Ready to Cook',
        features: ['Instant Cooking', 'Authentic Flavor', 'No Artificial Colors', 'Restaurant Quality'],
        availability: 'Future product',
        nutritionHighlights: ['Real mushrooms', 'Natural spices', 'Quick cooking']
    }
];

const categories = ['All', 'Fresh Mushrooms', 'Processed Products', 'Ready to Eat', 'Snacks', 'Ready to Cook', 'Traditional'];
---

<Head title="Premium Mushroom Products - Meaty Mushrooms" />

<main class="min-h-screen bg-white pt-20">
    <!-- Header -->
    <section class="pt-12 pb-8 bg-[#F8FAF8]">
        <div class="max-w-7xl mx-auto px-6">
            <nav class="flex items-center gap-2 text-sm text-stone-500 mb-6">
                <a href="/" class="hover:text-[#3A493E]">Home</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-[#3A493E]">Products</span>
            </nav>
            
            <div class="text-center max-w-3xl mx-auto">
                <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4">Our Products</h1>
                <p class="text-lg text-stone-600 mb-8">From fresh mushrooms to ready-to-eat delicacies, explore our complete range of premium mushroom products.</p>
                
                <!-- Category Filter -->
                <div class="flex flex-wrap justify-center gap-3">
                    {categories.map(category => (
                        <button class="category-filter px-4 py-2 rounded-full border border-[#3A493E] text-[#3A493E] hover:bg-[#3A493E] hover:text-white transition-all text-sm font-medium" data-category={category}>
                            {category}
                        </button>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Products Grid -->
    <section class="py-16">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8" id="products-grid">
                {products.map((product, index) => (
                    <div class="product-card bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-stone-100 group" data-category={product.category} data-aos="fade-up" data-aos-delay={index * 100}>
                        <div class="relative">
                            <Image src={product.image} alt={product.name} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                            <div class="absolute top-4 right-4">
                                <span class="bg-[#3A493E] text-white text-xs px-3 py-1 rounded-full">{product.availability}</span>
                            </div>
                            <div class="absolute top-4 left-4">
                                <span class="bg-white/90 text-[#3A493E] text-xs px-3 py-1 rounded-full font-medium">{product.category}</span>
                            </div>
                        </div>
                        
                        <div class="p-6">
                            <h3 class="text-lg font-semibold text-stone-900 mb-2">{product.name}</h3>
                            <p class="text-stone-600 text-sm mb-4 leading-relaxed">{product.description}</p>
                            
                            <!-- Features -->
                            <div class="flex flex-wrap gap-2 mb-4">
                                {product.features.map(feature => (
                                    <span class="text-xs bg-[#E9F0EA] text-[#3A493E] px-2 py-1 rounded-full">{feature}</span>
                                ))}
                            </div>
                            
                            <!-- Nutrition Highlights -->
                            <div class="mb-4">
                                <h4 class="text-xs font-semibold text-stone-700 mb-2">Nutrition Highlights:</h4>
                                <ul class="text-xs text-stone-600 space-y-1">
                                    {product.nutritionHighlights.map(highlight => (
                                        <li class="flex items-center gap-2">
                                            <i class="fas fa-check text-[#3A493E] text-xs"></i>
                                            {highlight}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                            
                            <div class="flex items-center justify-between">
                                <span class="text-[#3A493E] font-bold text-lg">{product.price}</span>
                
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="py-16 bg-[#F8FAF8]">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold text-stone-900 mb-4">Can't Find What You're Looking For?</h2>
            <p class="text-stone-600 mb-8">We offer custom products and bulk orders. Contact us for special requirements.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="tel:+918078937260" class="px-8 py-4 bg-[#3A493E] text-white rounded-full hover:bg-[#2C3A30] transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-phone"></i>
                    Call Us: +91 8078937260
                </a>
                <a href="https://wa.me/918078937260" class="px-8 py-4 border-2 border-[#3A493E] text-[#3A493E] rounded-full hover:bg-[#E9F0EA] transition-all flex items-center justify-center gap-2">
                    <i class="fab fa-whatsapp"></i>
                    WhatsApp
                </a>
            </div>
        </div>
    </section>
</main>

<Footer />

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterButtons = document.querySelectorAll('.category-filter');
        const productCards = document.querySelectorAll('.product-card');

        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Remove active class from all buttons
                filterButtons.forEach(btn => btn.classList.remove('bg-[#3A493E]', 'text-white'));
                filterButtons.forEach(btn => btn.classList.add('text-[#3A493E]'));
                
                // Add active class to clicked button
                this.classList.add('bg-[#3A493E]', 'text-white');
                this.classList.remove('text-[#3A493E]');

                const category = this.dataset.category;

                productCards.forEach(card => {
                    if (category === 'All' || card.dataset.category === category) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Set initial active state
        filterButtons[0].classList.add('bg-[#3A493E]', 'text-white');
        filterButtons[0].classList.remove('text-[#3A493E]');
    });
</script>
