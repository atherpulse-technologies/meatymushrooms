const categories = ['All', 'Fresh Mushrooms', 'Processed Products', 'Ready to Eat', 'Snacks', 'Ready to Cook', 'Traditional'];
const categoriesML = {
    'All': 'എല്ലാം',
    'Fresh Mushrooms': 'ഫ്രഷ് കൂണുകൾ',
    'Processed Products': 'മൂല്യവർദ്ധിത ഉൽപ്പന്നങ്ങൾ',
    'Ready to Eat': 'റെഡി ടു ഈറ്റ്',
    'Snacks': 'സ്നാക്സ്',
