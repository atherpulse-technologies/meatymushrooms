---

<Head title="Premium Mushroom Products - Meaty Mushrooms" />

<main class="min-h-screen bg-white pt-20">
    <!-- Header -->
    <section class="pt-12 pb-8 bg-stone-50">
        <div class="max-w-7xl mx-auto px-6">
            <nav class="flex items-center gap-2 text-sm text-stone-500 mb-6">
                <a href="/" class="hover:text-primary" data-ml="ഹോം">Home</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-primary" data-ml="ഉൽപ്പന്നങ്ങൾ">Products</span>
            </nav>
            
            <div class="text-center max-w-3xl mx-auto">
                <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4" data-ml="ഞങ്ങളുടെ ഉൽപ്പന്നങ്ങൾ">Our Products</h1>
                <p class="text-lg text-stone-600 mb-8" data-ml="ഫ്രഷ് കൂണുകൾ മുതൽ മൂല്യവർദ്ധിത ഉൽപ്പന്നങ്ങൾ വരെ - ഞങ്ങളുടെ പ്രീമിയം ഉൽപ്പന്നങ്ങൾ കാണാം.">From fresh mushrooms to ready-to-eat delicacies, explore our complete range of premium mushroom products.</p>
                
                <!-- Category Filter -->
                <div class="flex flex-wrap justify-center gap-3">
                    {categories.map(category => (
                        <button class="category-filter px-4 py-2 rounded-full border border-primary text-primary hover:bg-primary hover:text-white transition-all text-sm font-medium" data-category={category}>
                            <span data-ml={categoriesML[category]}>{category}</span>
                        </button>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Products Grid -->
    <section class="py-16">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8" id="products-grid">
                {products.map((product, index) => (
                    <div class="product-card bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-stone-100 group" data-category={product.category} data-aos="fade-up" data-aos-delay={index * 100}>
                        <div class="relative">
                            <Image src={product.image} alt={product.name} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                            <div class="absolute top-4 right-4">
                                <span class="bg-primary text-white text-xs px-3 py-1 rounded-full" data-ml={product.availabilityML}>{product.availability}</span>
                            </div>
                            <div class="absolute top-4 left-4">
                                <span class="bg-white/90 text-primary text-xs px-3 py-1 rounded-full font-medium" data-ml={product.categoryML}>{product.category}</span>
                            </div>
                        </div>
                        
                        <div class="p-6">
                            <h3 class="text-lg font-semibold text-stone-900 mb-2" data-ml={product.nameML}>{product.name}</h3>
                            <p class="text-stone-600 text-sm mb-4 leading-relaxed" data-ml={product.descriptionML}>{product.description}</p>
                            
                            <!-- Features -->
                            <div class="flex flex-wrap gap-2 mb-4">
                                {product.features.map((feature, idx) => (
                                    <span class="text-xs bg-primary-light text-primary px-2 py-1 rounded-full" data-ml={product.featuresML[idx]}>{feature}</span>
                                ))}
                            </div>
                            
                            <!-- Nutrition Highlights -->
                            <div class="mb-4">
                                <h4 class="text-xs font-semibold text-stone-700 mb-2" data-ml="പ്രധാന പോഷകങ്ങൾ:">Nutrition Highlights:</h4>
                                <ul class="text-xs text-stone-600 space-y-1">
                                    {product.nutritionHighlights.map(highlight => (
                                        <li class="flex items-center gap-2">
                                            <i class="fas fa-check text-primary text-xs"></i>
                                            {highlight}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                            
                            <div class="flex items-center justify-between">
                                <span class="text-primary font-bold text-lg">{product.price}</span>
                
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="py-16 bg-stone-50">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold text-stone-900 mb-4" data-ml="നിങ്ങൾക്ക് വേണ്ടത് കിട്ടുന്നില്ലേ?">Can't Find What You're Looking For?</h2>
            <p class="text-stone-600 mb-8" data-ml="ഞങ്ങൾ ബൾക്ക് ഓർഡറുകളും കസ്റ്റം ഓർഡറുകളും സ്വീകരിക്കുന്നു. കൂടുതൽ വിവരങ്ങൾക്ക് ഞങ്ങളെ ബന്ധപ്പെടുക.">We offer custom products and bulk orders. Contact us for special requirements.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="tel:+918078937260" class="px-8 py-4 bg-primary text-white rounded-full hover:bg-primary-dark transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-phone"></i>
                    <span data-ml="വിളിക്കൂ: +91 8078937260">Call Us: +91 8078937260</span>
                </a>
                <a href="https://wa.me/918078937260" class="px-8 py-4 border-2 border-primary text-primary rounded-full hover:bg-primary-light transition-all flex items-center justify-center gap-2">
                    <i class="fab fa-whatsapp"></i>
                    WhatsApp
                </a>
            </div>
        </div>
    </section>
</main>

<Footer />

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterButtons = document.querySelectorAll('.category-filter');
        const productCards = document.querySelectorAll('.product-card');

        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Remove active class from all buttons
                filterButtons.forEach(btn => {
                    btn.classList.remove('bg-primary', 'text-white');
                    btn.classList.add('text-primary');
                });
                
                // Add active class to clicked button
                this.classList.remove('text-primary');
                this.classList.add('bg-primary', 'text-white');

                const category = this.dataset.category;

                productCards.forEach(card => {
                    if (category === 'All' || card.dataset.category === category) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Set initial active state
        filterButtons[0].classList.remove('text-primary');
        filterButtons[0].classList.add('bg-primary', 'text-white');
    });
</script>
