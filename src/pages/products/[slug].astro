---
import Head from "../../components/Head.astro";
import Footer from "../../components/Footer.astro";
import CartDrawer from "../../components/store/CartDrawer.astro";
import ProductCard from "../../components/store/ProductCard.astro";
import { getProductBySlug, products } from "../../data/products";

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const related = products.filter((entry) => entry.form === product.form && entry.slug !== product.slug).slice(0, 3);
const qtyInputId = `qty-${product.slug}`;
---

<Head title={`${product.name} - Meaty Mushrooms | Premium Mushrooms from Vadakara`} />

<CartDrawer />

<main class="min-h-screen bg-white pt-24 pb-20">
  <section class="border-b border-stone-200 bg-white py-10">
    <div class="max-w-7xl mx-auto px-6">
      <a href="/#store" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-600 hover:text-primary">
        <i class="fa-solid fa-arrow-left"></i>
        Back to store
      </a>

      <div class="mt-6 grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="rounded-xl border border-stone-200 bg-stone-50 p-4">
            <img src={product.image} alt={product.name} class="h-[360px] w-full object-contain" />
          </div>
        </article>

        <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
          <span class="rounded-full bg-primary/10 px-3 py-1 text-[11px] font-extrabold tracking-wide text-primary">Available</span>
          <h1 class="mt-3 text-4xl font-bold text-stone-900">{product.name}</h1>
          <p class="mt-3 text-sm text-stone-600">{product.tagline}</p>

          <div class="mt-5 flex items-center justify-between rounded-xl bg-primary-light px-4 py-3">
            <p class="text-sm text-stone-600">Price</p>
            <p class="text-xl font-bold text-stone-900">₹{product.price} <span class="text-sm font-semibold text-stone-500">| {product.unit}</span></p>
          </div>

          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div class="rounded-lg bg-stone-100 p-3">
              <p class="text-xs font-bold uppercase tracking-wide text-stone-500">Form</p>
              <p class="mt-1 text-sm font-semibold text-stone-800">{product.form === "fresh" ? "Fresh" : product.form === "dried" ? "Dried & Powder" : "Pickled"}</p>
            </div>
            <div class="rounded-lg bg-stone-100 p-3">
              <p class="text-xs font-bold uppercase tracking-wide text-stone-500">Storage</p>
              <p class="mt-1 text-sm font-semibold text-stone-800">{product.storage}</p>
            </div>
          </div>

          <p class="mt-5 text-stone-600">{product.longDescription}</p>

          <div class="mt-6 flex items-center gap-3">
            <label for={qtyInputId} class="text-sm font-semibold text-stone-600">Qty</label>
            <input id={qtyInputId} type="number" min="1" value="1" class="w-20 rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold" />
          </div>

          <div class="mt-4 flex flex-wrap gap-3">
            <button
              class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-white hover:bg-primary-dark"
              data-add-to-cart
              data-product-slug={product.slug}
              data-product-name={product.name}
              data-product-price={product.price}
              data-product-image={product.image}
              data-product-unit={product.unit}
              data-qty-input={qtyInputId}
            >
              <i class="fa-solid fa-cart-plus"></i>
              Add to Cart
            </button>
            <button class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-white hover:bg-primary-dark" data-open-cart>
              <i class="fa-solid fa-credit-card"></i>
              Go to Checkout
            </button>
          </div>

          <section class="mt-7 rounded-xl border border-stone-200 bg-stone-50 p-4">
            <h2 class="text-xl font-bold text-stone-900">Highlights</h2>
            <ul class="mt-3 space-y-2 text-sm text-stone-700">
              {product.highlights.map((point) => (
                <li class="flex items-start gap-2"><i class="fa-solid fa-circle-check mt-0.5 text-primary"></i> {point}</li>
              ))}
            </ul>
          </section>

          <section class="mt-4 rounded-xl border border-stone-200 bg-stone-50 p-4">
            <h2 class="text-xl font-bold text-stone-900">How to Use</h2>
            <div class="mt-3 flex flex-wrap gap-2">
              {product.usage.map((item) => (
                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-stone-700">{item}</span>
              ))}
            </div>
          </section>
        </article>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-stone-900">Related products</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {related.map((item) => <ProductCard product={item} />)}
        </div>
      </div>
    </section>
  )}
</main>

<Footer />

<script type="module" src="/js/site-ui.js"></script>
