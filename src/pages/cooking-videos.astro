                    </div>
                    <h3 class="font-semibold text-stone-900 mb-2">Traditional Kerala</h3>
                    <p class="text-sm text-stone-600 mb-4">Authentic Kerala mushroom recipes</p>
                    <span class="text-xs bg-[#E9F0EA] text-[#3A493E] px-2 py-1 rounded-full">8 Videos</span>
                </div>

                <div class="bg-white rounded-xl p-6 text-center hover:shadow-lg transition-all group">
                    <div class="w-16 h-16 bg-[#3A493E]/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-[#3A493E]/20 transition-colors">
                        <i class="fas fa-fire text-[#3A493E] text-2xl"></i>
                    </div>
                    <h3 class="font-semibold text-stone-900 mb-2">Quick & Easy</h3>
                    <p class="text-sm text-stone-600 mb-4">Fast recipes for busy days</p>
                    <span class="text-xs bg-[#E9F0EA] text-[#3A493E] px-2 py-1 rounded-full">5 Videos</span>
                </div>

                <div class="bg-white rounded-xl p-6 text-center hover:shadow-lg transition-all group">
                    <div class="w-16 h-16 bg-[#3A493E]/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-[#3A493E]/20 transition-colors">
                        <i class="fas fa-graduation-cap text-[#3A493E] text-2xl"></i>
                    </div>
                    <h3 class="font-semibold text-stone-900 mb-2">Beginner Friendly</h3>
                    <p class="text-sm text-stone-600 mb-4">Perfect for cooking beginners</p>
                    <span class="text-xs bg-[#E9F0EA] text-[#3A493E] px-2 py-1 rounded-full">6 Videos</span>
                </div>

                <div class="bg-white rounded-xl p-6 text-center hover:shadow-lg transition-all group">
                    <div class="w-16 h-16 bg-[#3A493E]/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-[#3A493E]/20 transition-colors">
                        <i class="fas fa-seedling text-[#3A493E] text-2xl"></i>
                    </div>
                    <h3 class="font-semibold text-stone-900 mb-2">Growing Tips</h3>
                    <p class="text-sm text-stone-600 mb-4">Learn to grow your own mushrooms</p>
                    <span class="text-xs bg-[#E9F0EA] text-[#3A493E] px-2 py-1 rounded-full">3 Videos</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Subscribe Section -->
    <section class="py-16 bg-white">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <div class="bg-gradient-to-r from-red-600 to-red-700 rounded-2xl p-12 text-white">
                <i class="fab fa-youtube text-6xl mb-6"></i>
                <h2 class="text-3xl font-bold mb-4">Subscribe to Our YouTube Channel</h2>
                <p class="text-white/80 mb-8 text-lg">Get notified when we upload new mushroom cooking videos and recipes!</p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="https://www.youtube.com/@meatymushrooms" target="_blank" class="px-8 py-4 bg-white text-red-600 rounded-full hover:bg-gray-100 transition-all flex items-center justify-center gap-2 font-semibold">
                        <i class="fab fa-youtube"></i>
                        Subscribe Now
                    </a>
                    <a href="https://www.youtube.com/@meatymushrooms/playlists" target="_blank" class="px-8 py-4 border-2 border-white text-white rounded-full hover:bg-white hover:text-red-600 transition-all flex items-center justify-center gap-2 font-semibold">
                        <i class="fas fa-list"></i>
                        View Playlists
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>

<Footer />

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterButtons = document.querySelectorAll('.category-filter');
        const videoCards = document.querySelectorAll('.video-card');

        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Remove active class from all buttons
                filterButtons.forEach(btn => btn.classList.remove('bg-[#3A493E]', 'text-white'));
                filterButtons.forEach(btn => btn.classList.add('text-[#3A493E]'));
                
                // Add active class to clicked button
                this.classList.add('bg-[#3A493E]', 'text-white');
                this.classList.remove('text-[#3A493E]');

                const category = this.dataset.category;

                videoCards.forEach(card => {
                    if (category === 'All' || card.dataset.category === category) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Set initial active state
        filterButtons[0].classList.add('bg-[#3A493E]', 'text-white');
        filterButtons[0].classList.remove('text-[#3A493E]');
    });
</script>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
