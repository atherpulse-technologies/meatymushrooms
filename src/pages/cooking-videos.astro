---
import VideoLayout from '../layouts/VideoLayout.astro';

const videos = [
    {
        id: 'dQw4w9WgXcQ',
        title: 'Basic Mushroom Stir Fry',
        description: 'Learn the fundamentals of cooking oyster mushrooms with this simple stir-fry recipe.',
        duration: '5:30',
        category: 'Beginner'
    },
    {
        id: 'dQw4w9WgXcQ',
        title: 'Traditional Mushroom Curry',
        description: 'Authentic Kerala-style mushroom curry with coconut and spices.',
        duration: '8:45',
        category: 'Intermediate'
    },
    {
        id: 'dQw4w9WgXcQ',
        title: 'Perfect Grilled Mushrooms',
        description: 'Master the art of grilling mushrooms for maximum flavor and texture.',
        duration: '6:20',
        category: 'Beginner'
    },
    // Add more videos as needed
];
---

<VideoLayout title="Cooking Videos" description="Master the art of cooking mushrooms with our expert video guides and tutorials.">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {videos.map((video, index) => (
            <div class="bg-[#F8FAF8] rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-aos="fade-up" data-aos-delay={index * 100}>
                <div class="relative">
                    <img 
                        src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`} 
                        alt={video.title} 
                        class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" 
                        loading="lazy" 
                    />
                    <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <i class="fas fa-play text-white text-3xl"></i>
                    </div>
                    <span class="absolute top-4 left-4 bg-red-600 text-white text-xs px-2 py-1 rounded">{video.duration}</span>
                    <span class="absolute top-4 right-4 bg-white/90 text-[#3A493E] text-xs px-2 py-1 rounded">{video.category}</span>
                </div>
                <div class="p-6">
                    <h3 class="text-lg font-semibold text-stone-900 mb-2">{video.title}</h3>
                    <p class="text-stone-600 text-sm mb-4">{video.description}</p>
                    <a 
                        href={`https://youtube.com/watch?v=${video.id}`} 
                        target="_blank" 
                        class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors"
                    >
                        Watch on YouTube
                        <i class="fas fa-external-link-alt text-sm"></i>
                    </a>
                </div>
            </div>
        ))}
    </div>
</VideoLayout>
