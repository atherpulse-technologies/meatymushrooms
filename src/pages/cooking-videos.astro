---

<Head title="Mushroom Cooking Videos - Learn to Cook Delicious Mushroom Recipes" />

<main class="min-h-screen bg-white pt-20">
    <!-- Header -->
    <section class="pt-12 pb-8 bg-[#F8FAF8]">
        <div class="max-w-7xl mx-auto px-6">
            <nav class="flex items-center gap-2 text-sm text-stone-500 mb-6">
                <a href="/" class="hover:text-[#3A493E]">Home</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-[#3A493E]">Cooking Videos</span>
            </nav>
            
            <div class="text-center max-w-3xl mx-auto">
                <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4">
                    <i class="fas fa-video text-[#3A493E] mr-4"></i>
                    Mushroom Cooking Videos
                </h1>
                <p class="text-lg text-stone-600 mb-8">Master the art of cooking mushrooms with our comprehensive collection of video tutorials. From traditional Kerala recipes to modern techniques.</p>
                
                <!-- Category Filter -->
                <div class="flex flex-wrap justify-center gap-3">
                    {categories.map(category => (
                        <button class="category-filter px-4 py-2 rounded-full border border-[#3A493E] text-[#3A493E] hover:bg-[#3A493E] hover:text-white transition-all text-sm font-medium" data-category={category}>
                            {category}
                        </button>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Videos Grid -->
    <section class="py-16">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8" id="videos-grid">
                {cookingVideos.map((video, index) => (
                    <div class="video-card bg-[#F8FAF8] rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-category={video.category} data-aos="fade-up" data-aos-delay={index * 50}>
                        <div class="relative">
                            <img src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`} alt={video.title} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                            <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center">
                                    <i class="fas fa-play text-white text-xl"></i>
                                </div>
                            </div>
                            <div class="absolute top-4 left-4 flex gap-2">
                                <span class="bg-red-600 text-white text-xs px-2 py-1 rounded">{video.label}</span>
                                <span class="bg-[#3A493E] text-white text-xs px-2 py-1 rounded">{video.category}</span>
                            </div>
                        </div>
                        
                        <div class="p-6">
                            <h3 class="text-lg font-semibold text-stone-900 mb-2 line-clamp-2">{video.title}</h3>
                            <p class="text-stone-600 text-sm mb-4 leading-relaxed line-clamp-2">{video.description}</p>
                            
                            <div class="flex items-center justify-between">
                                <a href={`https://youtube.com/watch?v=${video.id}`} target="_blank" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors">
                                    <i class="fab fa-youtube"></i>
                                    Watch Video
                                </a>
                                <div class="flex gap-2">
                                    <button class="p-2 text-stone-400 hover:text-[#3A493E] transition-colors" title="Save for later">
                                        <i class="fas fa-bookmark"></i>
                                    </button>
                                    <button class="p-2 text-stone-400 hover:text-[#3A493E] transition-colors" title="Share">
                                        <i class="fas fa-share"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>

            <!-- Load More Button -->
            <div class="text-center mt-12">
                <button class="px-8 py-3 border-2 border-[#3A493E] text-[#3A493E] rounded-full hover:bg-[#3A493E] hover:text-white transition-all font-medium">
                    Load More Videos
                </button>
            </div>
        </div>
    </section>

    <!-- Featured Playlists -->
    <section class="py-16 bg-[#F8FAF8]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-stone-900 mb-4">Popular Recipe Categories</h2>
                <p class="text-stone-600">Explore videos by cooking style and difficulty level</p>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
