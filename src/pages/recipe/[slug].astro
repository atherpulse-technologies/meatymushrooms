---
import RecipeLayout from '../../layouts/RecipeLayout.astro';
import { Image } from 'astro:assets';
import oyster from '../../assets/images/oyster.jpg';
import pink from '../../assets/images/pink.jpg';
import buttonmush from '../../assets/images/button.jpg';

// This would typically come from a CMS or database
const recipes = {
    'mushroom-biryani': {
        title: 'Mushroom Biryani',
        description: 'Aromatic basmati rice cooked with tender mushrooms and traditional spices',
        cookTime: '30 min',
        prepTime: '15 min',
        difficulty: 'Medium',
        cuisine: 'Indian',
        rating: 5,
        reviews: 24,
        servings: 4,
        calories: 320,
        image: oyster
    },
    'mushroom-soup': {
        title: 'Creamy Mushroom Soup',
        description: 'Rich and creamy soup perfect for cold evenings with fresh herbs',
        cookTime: '20 min',
        prepTime: '5 min',
        difficulty: 'Easy',
        cuisine: 'Continental',
        rating: 4,
        reviews: 18,
        servings: 3,
        calories: 180,
        image: pink
    },
    'mushroom-stir-fry': {
        title: 'Quick Mushroom Stir Fry',
        description: 'Fast and healthy stir-fry with colorful vegetables and savory sauce',
        cookTime: '10 min',
        prepTime: '5 min',
        difficulty: 'Easy',
        cuisine: 'Asian',
        rating: 5,
        reviews: 31,
        servings: 2,
        calories: 150,
        image: buttonmush
    },
    'mushroom-curry': {
        title: 'Kerala Style Mushroom Curry',
        description: 'Traditional Kerala curry with coconut milk and aromatic spices',
        cookTime: '30 min',
        prepTime: '5 min',
        difficulty: 'Medium',
        cuisine: 'Indian',
        rating: 5,
        reviews: 42,
        servings: 4,
        calories: 280,
        image: oyster
    },
    'mushroom-pasta': {
        title: 'Creamy Mushroom Pasta',
        description: 'Rich and indulgent pasta with sautéed mushrooms in cream sauce',
        cookTime: '15 min',
        prepTime: '5 min',
        difficulty: 'Easy',
        cuisine: 'Italian',
        rating: 4,
        reviews: 28,
        servings: 2,
        calories: 420,
        image: pink
    },
    'mushroom-risotto': {
        title: 'Mushroom Risotto',
        description: 'Creamy Italian rice dish with mixed mushrooms and parmesan',
        cookTime: '35 min',
        prepTime: '5 min',
        difficulty: 'Hard',
        cuisine: 'Italian',
        rating: 5,
        reviews: 19,
        servings: 4,
        calories: 380,
        image: buttonmush
    },
    'mushroom-pizza': {
        title: 'Mushroom Pizza',
        description: 'Homemade pizza topped with fresh mushrooms and herbs',
        cookTime: '25 min',
        prepTime: '5 min',
        difficulty: 'Medium',
        cuisine: 'Italian',
        rating: 4,
        reviews: 35,
        servings: 2,
        calories: 350,
        image: oyster
    },
    'mushroom-salad': {
        title: 'Grilled Mushroom Salad',
        description: 'Fresh salad with grilled mushrooms and balsamic dressing',
        cookTime: '10 min',
        prepTime: '5 min',
        difficulty: 'Easy',
        cuisine: 'Mediterranean',
        rating: 4,
        reviews: 22,
        servings: 2,
        calories: 120,
        image: pink
    },
    'mushroom-sandwich': {
        title: 'Mushroom Grilled Sandwich',
        description: 'Crispy grilled sandwich with sautéed mushrooms and cheese',
        cookTime: '8 min',
        prepTime: '2 min',
        difficulty: 'Easy',
        cuisine: 'Continental',
        rating: 4,
        reviews: 16,
        servings: 1,
        calories: 280,
        image: buttonmush
    }
};

// Required function for dynamic routes
export async function getStaticPaths() {
    return Object.keys(recipes).map((slug) => ({
        params: { slug },
    }));
}

const { slug } = Astro.params;
const recipe = recipes[slug as keyof typeof recipes];

if (!recipe) {
    return Astro.redirect('/404');
}
---

<RecipeLayout {...recipe}>
    <div slot="ingredients">
        <ul class="space-y-3">
            <li class="flex items-center gap-3">
                <input type="checkbox" class="w-4 h-4 text-[#3A493E] bg-gray-100 border-gray-300 rounded focus:ring-[#3A493E]">
                <span class="text-stone-700">250g fresh oyster mushrooms</span>
            </li>
            <li class="flex items-center gap-3">
                <input type="checkbox" class="w-4 h-4 text-[#3A493E] bg-gray-100 border-gray-300 rounded focus:ring-[#3A493E]">
                <span class="text-stone-700">2 cups basmati rice</span>
            </li>
            <li class="flex items-center gap-3">
                <input type="checkbox" class="w-4 h-4 text-[#3A493E] bg-gray-100 border-gray-300 rounded focus:ring-[#3A493E]">
                <span class="text-stone-700">1 large onion, sliced</span>
            </li>
            <li class="flex items-center gap-3">
                <input type="checkbox" class="w-4 h-4 text-[#3A493E] bg-gray-100 border-gray-300 rounded focus:ring-[#3A493E]">
                <span class="text-stone-700">3 cloves garlic, minced</span>
            </li>
            <li class="flex items-center gap-3">
                <input type="checkbox" class="w-4 h-4 text-[#3A493E] bg-gray-100 border-gray-300 rounded focus:ring-[#3A493E]">
                <span class="text-stone-700">2 tbsp vegetable oil</span>
            </li>
            <li class="flex items-center gap-3">
                <input type="checkbox" class="w-4 h-4 text-[#3A493E] bg-gray-100 border-gray-300 rounded focus:ring-[#3A493E]">
                <span class="text-stone-700">1 tsp garam masala</span>
            </li>
            <li class="flex items-center gap-3">
                <input type="checkbox" class="w-4 h-4 text-[#3A493E] bg-gray-100 border-gray-300 rounded focus:ring-[#3A493E]">
                <span class="text-stone-700">Salt to taste</span>
            </li>
        </ul>
    </div>

    <div slot="instructions">
        <div class="flex gap-4 p-6 bg-white rounded-xl border border-stone-100">
            <div class="w-8 h-8 bg-[#3A493E] text-white rounded-full flex items-center justify-center font-semibold text-sm shrink-0">1</div>
            <div>
                <h3 class="font-semibold text-stone-900 mb-2">Prepare the Rice</h3>
                <p class="text-stone-600">Wash and soak basmati rice for 30 minutes. Cook with whole spices until 70% done.</p>
            </div>
        </div>

        <div class="flex gap-4 p-6 bg-white rounded-xl border border-stone-100">
            <div class="w-8 h-8 bg-[#3A493E] text-white rounded-full flex items-center justify-center font-semibold text-sm shrink-0">2</div>
            <div>
                <h3 class="font-semibold text-stone-900 mb-2">Sauté Mushrooms</h3>
                <p class="text-stone-600">Heat oil in a pan. Add sliced onions and cook until golden. Add mushrooms and cook for 5 minutes.</p>
            </div>
        </div>

        <div class="flex gap-4 p-6 bg-white rounded-xl border border-stone-100">
            <div class="w-8 h-8 bg-[#3A493E] text-white rounded-full flex items-center justify-center font-semibold text-sm shrink-0">3</div>
            <div>
                <h3 class="font-semibold text-stone-900 mb-2">Layer and Cook</h3>
                <p class="text-stone-600">Layer the partially cooked rice over mushrooms. Cover and cook on low heat for 45 minutes.</p>
            </div>
        </div>
    </div>

    <div slot="tips">
        <ul class="space-y-2 text-blue-800">
            <li>• Use aged basmati rice for best results</li>
            <li>• Don't overcook the mushrooms to maintain texture</li>
            <li>• Let the biryani rest for 10 minutes before serving</li>
        </ul>
    </div>

    <div slot="related-recipes">
        <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl overflow-hidden hover:shadow-lg transition-all">
                <Image src={pink} alt="Mushroom Soup" class="w-full h-40 object-cover" />
                <div class="p-4">
                    <h3 class="font-semibold mb-2">Mushroom Soup</h3>
                    <a href="/recipe/mushroom-soup" class="text-[#3A493E] text-sm hover:underline">View Recipe →</a>
                </div>
            </div>
            <div class="bg-white rounded-xl overflow-hidden hover:shadow-lg transition-all">
                <Image src={buttonmush} alt="Mushroom Stir Fry" class="w-full h-40 object-cover" />
                <div class="p-4">
                    <h3 class="font-semibold mb-2">Mushroom Stir Fry</h3>
                    <a href="/recipe/mushroom-stir-fry" class="text-[#3A493E] text-sm hover:underline">View Recipe →</a>
                </div>
            </div>
        </div>
    </div>
</RecipeLayout>
