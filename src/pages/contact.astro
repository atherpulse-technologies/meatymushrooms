---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
---

<Head title="Contact Us - Meaty Mushrooms | Vadakara, Kozhikode" />

<main class="min-h-screen bg-white pt-20">
    <!-- Header -->
    <section class="pt-16 pb-12 bg-stone-50">
        <div class="max-w-4xl mx-auto px-6">
            <nav class="flex items-center gap-2 text-sm text-stone-500 mb-6">
                <a href="/" class="hover:text-primary">Home</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-primary">Contact</span>
            </nav>
            
            <div class="text-center">
                <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4">Contact Us</h1>
                <p class="text-lg text-stone-600 max-w-2xl mx-auto">We'd love to hear from you. Reach out for orders, enquiries, or farm visits.</p>
            </div>
        </div>
    </section>

    <!-- Contact Details -->
    <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-6">
            <div class="grid md:grid-cols-2 gap-12">
                <!-- Contact Info -->
                <div>
                    <h2 class="text-2xl font-bold text-stone-900 mb-6">Get in Touch</h2>
                    
                    <div class="space-y-5">
                        <div class="flex items-start gap-4 p-4 bg-stone-50 rounded-xl">
                            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                                <i class="fas fa-phone text-primary"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-stone-900">Phone</p>
                                <a href="tel:+918078937260" class="text-primary hover:underline">+91 80789 37260</a>
                            </div>
                        </div>

                        <div class="flex items-start gap-4 p-4 bg-stone-50 rounded-xl">
                            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                                <i class="fab fa-whatsapp text-primary"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-stone-900">WhatsApp</p>
                                <a href="https://wa.me/918078937260" target="_blank" class="text-primary hover:underline">Chat on WhatsApp</a>
                                <p class="text-xs text-stone-500 mt-1">Fastest way to place an order</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4 p-4 bg-stone-50 rounded-xl">
                            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                                <i class="fas fa-envelope text-primary"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-stone-900">Email</p>
                                <a href="mailto:support@meatymushrooms.in" class="text-primary hover:underline">support@meatymushrooms.in</a>
                            </div>
                        </div>

                        <div class="flex items-start gap-4 p-4 bg-stone-50 rounded-xl">
                            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                                <i class="fas fa-clock text-primary"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-stone-900">Business Hours</p>
                                <p class="text-stone-600 text-sm">Monday - Saturday: 9:00 AM - 6:00 PM</p>
                                <p class="text-stone-600 text-sm">Sunday: 10:00 AM - 2:00 PM</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Address & Directions -->
                <div>
                    <h2 class="text-2xl font-bold text-stone-900 mb-6">Visit Our Farm</h2>
                    
                    <div class="bg-stone-50 rounded-xl p-6 mb-6">
                        <h3 class="font-semibold text-stone-900 mb-2">Address</h3>
                        <p class="text-stone-600 leading-relaxed">
                            Keethadi Road, Makkoolpeedika<br>
                            Vadakara, Kozhikode District<br>
                            Kerala 673104, India
                        </p>
                    </div>

                    <div class="bg-stone-50 rounded-xl p-6 mb-6">
                        <h3 class="font-semibold text-stone-900 mb-3">How to Reach</h3>
                        <div class="space-y-3 text-sm text-stone-600">
                            <div class="flex items-start gap-2">
                                <i class="fas fa-train text-primary mt-1"></i>
                                <span><strong>By Train:</strong> Nearest station is <strong>Vadakara Railway Station</strong> (approx. 2 km from the farm). Auto-rickshaws available from the station.</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-bus text-primary mt-1"></i>
                                <span><strong>By Bus:</strong> <strong>Vadakara KSRTC Bus Stand</strong> (approx. 1.5 km). Local autos and taxis available.</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-car text-primary mt-1"></i>
                                <span><strong>By Road:</strong> Located on Keethadi Road in Makkoolpeedika. Easily accessible from NH-66. Use Google Maps for exact directions.</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-primary/5 rounded-xl p-6 border border-primary/10">
                        <p class="text-sm text-stone-600">
                            <i class="fas fa-info-circle text-primary mr-1"></i>
                            Farm visits are welcome! Please call or WhatsApp ahead to schedule a visit so we can give you our full attention.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Map -->
            <div class="mt-12 rounded-2xl overflow-hidden border border-stone-200 shadow-sm">
                <iframe
                    title="Meaty Mushrooms location in Vadakara"
                    src="https://www.google.com/maps?q=Vadakara,Kerala,India&z=14&output=embed" 
                    class="w-full h-80 border-0"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-primary">
        <div class="max-w-3xl mx-auto px-6 text-center text-white">
            <h2 class="text-3xl font-bold mb-4">Ready to Order?</h2>
            <p class="text-white/80 mb-8">Chat with us on WhatsApp for the fastest order processing.</p>
            <a href="https://wa.me/918078937260" target="_blank" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-primary rounded-full hover:bg-gray-100 transition-all font-semibold text-lg">
                <i class="fab fa-whatsapp"></i>
                Order on WhatsApp
            </a>
        </div>
    </section>
</main>

<Footer />
