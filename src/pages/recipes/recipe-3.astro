---
import RecipeLayout from "../../layouts/RecipeLayout.astro";
---

<RecipeLayout 
    title="Quick Mushroom Stir Fry"
    description="Fast and healthy stir-fry with colorful vegetables and savory sauce"
    cookTime="15 min"
    difficulty="Easy"
    cuisine="Asian"
    rating={5}
    reviews={31}
    image="/src/assets/images/button.jpg"
>
    <div class="grid lg:grid-cols-3 gap-12">
        <!-- Ingredients -->
        <div class="lg:col-span-1">
            <div class="sticky top-8 space-y-8">
                <div class="bg-gray-50 rounded-2xl p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-4">Ingredients</h3>
                    <ul class="space-y-3">
                        <li class="flex items-center gap-3">
                            <span class="w-2 h-2 bg-[#3A493E] rounded-full"></span>
                            <span class="text-gray-700">300g oyster mushrooms</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="w-2 h-2 bg-[#3A493E] rounded-full"></span>
                            <span class="text-gray-700">1 bell pepper, sliced</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="w-2 h-2 bg-[#3A493E] rounded-full"></span>
                            <span class="text-gray-700">2 carrots, julienned</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="w-2 h-2 bg-[#3A493E] rounded-full"></span>
                            <span class="text-gray-700">3 cloves garlic, minced</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="w-2 h-2 bg-[#3A493E] rounded-full"></span>
                            <span class="text-gray-700">2 tbsp soy sauce</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="w-2 h-2 bg-[#3A493E] rounded-full"></span>
                            <span class="text-gray-700">1 tbsp oyster sauce</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="w-2 h-2 bg-[#3A493E] rounded-full"></span>
                            <span class="text-gray-700">Spring onions for garnish</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-[#3A493E] text-white rounded-2xl p-6">
                    <h3 class="text-lg font-bold mb-3">Quick Tip</h3>
                    <p class="text-white/90 text-sm">Have all ingredients prepped and ready before you start cooking. Stir-frying happens fast!</p>
                </div>
            </div>
        </div>

        <!-- Instructions -->
        <div class="lg:col-span-2">
            <h3 class="text-2xl font-bold text-gray-900 mb-8">Instructions</h3>
            <div class="space-y-8">
                <div class="flex gap-6">
                    <div class="flex-shrink-0 w-8 h-8 bg-[#3A493E] text-white rounded-full flex items-center justify-center font-bold text-sm">1</div>
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">Heat the Wok</h4>
                        <p class="text-gray-600 leading-relaxed">Heat oil in a wok or large pan over high heat. The oil should be smoking hot for the best stir-fry results.</p>
                    </div>
                </div>

                <div class="flex gap-6">
                    <div class="flex-shrink-0 w-8 h-8 bg-[#3A493E] text-white rounded-full flex items-center justify-center font-bold text-sm">2</div>
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">Add Aromatics</h4>
                        <p class="text-gray-600 leading-relaxed">Add minced garlic and stir-fry for 30 seconds until fragrant. Be careful not to burn the garlic.</p>
                    </div>
                </div>

                <div class="flex gap-6">
                    <div class="flex-shrink-0 w-8 h-8 bg-[#3A493E] text-white rounded-full flex items-center justify-center font-bold text-sm">3</div>
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">Cook Mushrooms</h4>
                        <p class="text-gray-600 leading-relaxed">Add mushrooms and cook for 3-4 minutes, stirring constantly, until they start to caramelize and turn golden.</p>
                    </div>
                </div>

                <div class="flex gap-6">
                    <div class="flex-shrink-0 w-8 h-8 bg-[#3A493E] text-white rounded-full flex items-center justify-center font-bold text-sm">4</div>
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">Add Vegetables</h4>
                        <p class="text-gray-600 leading-relaxed">Add bell peppers and carrots. Stir-fry for 2 minutes until vegetables are crisp-tender but still vibrant in color.</p>
                    </div>
                </div>

                <div class="flex gap-6">
                    <div class="flex-shrink-0 w-8 h-8 bg-[#3A493E] text-white rounded-full flex items-center justify-center font-bold text-sm">5</div>
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">Season and Serve</h4>
                        <p class="text-gray-600 leading-relaxed">Mix soy sauce and oyster sauce, then add to the pan. Toss everything together for 1 minute. Garnish with chopped spring onions and serve immediately over rice.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</RecipeLayout>
