---
import "../assets/css/styles.css";
import About from "../components/About.astro";

---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atherpulse Technologies - Affordable Web Design, Development & Digital Innovation</title>
    <meta name="description" content="Your website dream made affordable! Atherpulse Technologies offers professional web design, development, SEO, and free hosting. Get a stunning online presence without the hefty price tag.">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="font-inter antialiased">
    <!-- Navigation -->
    <nav class="fixed top-0 w-full bg-white/80 backdrop-blur-md border-b border-gray-200/50 z-50">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Brand -->
                <a href="/" class="flex items-center space-x-2">
                    <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-purple-600 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">A</span>
                    </div>
                    <span class="text-xl font-bold text-gray-900">Atherpulse</span>
                    <span class="text-sm font-medium text-gray-600">Technologies</span>
                </a>
                
                <!-- Navigation Links -->
                <div class="hidden md:flex items-center space-x-8">
                    <a href="#about" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">About</a>
                    <a href="#services" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">Services</a>
                    <a href="#tech-stack" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">Tech Stack</a>
                    <a href="#projects" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">Projects</a>
                    <button class="bg-blue-600 text-white px-6 py-2 rounded-full font-medium hover:bg-blue-700 transition-colors">
                        Contact Us
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="pt-24 pb-16 bg-gradient-to-br from-gray-50 via-white to-blue-50 min-h-screen flex items-center">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <!-- Hero Content -->
                <div class="space-y-8">
                    <!-- Status Badge -->
                    <div class="inline-flex items-center space-x-2 bg-green-50 border border-green-200 rounded-full px-4 py-2">
                        <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                        <span class="text-green-700 font-medium text-sm">Available for new projects</span>
                    </div>

                    <!-- Main Heading -->
                    <h1 class="text-5xl lg:text-6xl font-bold text-gray-900 leading-tight">
                        Crafting Digital Excellence
                        <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
                            for Brands
                        </span>
                    </h1>

                    <!-- Description -->
                    <p class="text-xl text-gray-600 leading-relaxed max-w-2xl">
                        Your Website Dream Made Affordable. Stop paying ₹50k+ for websites. 
                        Get a professional online presence at affordable rates with no technical knowledge needed.
                    </p>

                    <!-- Action Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4">
                        <button class="bg-blue-600 text-white px-8 py-4 rounded-xl font-semibold hover:bg-blue-700 transform hover:-translate-y-0.5 transition-all duration-200 shadow-lg hover:shadow-xl">
                            Learn More
                        </button>
                        <button class="border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-xl font-semibold hover:border-blue-600 hover:text-blue-600 transition-colors">
                            View Case Studies
                        </button>
                    </div>

                    <!-- Stats -->
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 pt-8">
                        <div class="text-center lg:text-left">
                            <div class="text-3xl font-bold text-blue-600">98%</div>
                            <div class="text-sm text-gray-600 font-medium">Client Satisfaction</div>
                        </div>
                        <div class="text-center lg:text-left">
                            <div class="text-3xl font-bold text-blue-600">150+</div>
                            <div class="text-sm text-gray-600 font-medium">Projects Completed</div>
                        </div>
                        <div class="text-center lg:text-left">
                            <div class="text-3xl font-bold text-blue-600">10+</div>
                            <div class="text-sm text-gray-600 font-medium">Years Experience</div>
                        </div>
                        <div class="text-center lg:text-left">
                            <div class="text-3xl font-bold text-blue-600">32</div>
                            <div class="text-sm text-gray-600 font-medium">Team Members</div>
                        </div>
                    </div>
                </div>

                <!-- Hero Visual -->
                <div class="relative lg:h-96">
                    <!-- Decorative Elements -->
                    <div class="absolute inset-0 grid grid-cols-3 gap-4 opacity-20">
                        <div class="bg-gradient-to-br from-blue-400 to-blue-600 rounded-2xl transform rotate-6"></div>
                        <div class="bg-gradient-to-br from-purple-400 to-purple-600 rounded-2xl transform -rotate-3"></div>
                        <div class="bg-gradient-to-br from-indigo-400 to-indigo-600 rounded-2xl transform rotate-12"></div>
                        <div class="bg-gradient-to-br from-cyan-400 to-cyan-600 rounded-2xl transform -rotate-6"></div>
                        <div class="bg-gradient-to-br from-violet-400 to-violet-600 rounded-2xl transform rotate-3"></div>
                        <div class="bg-gradient-to-br from-blue-400 to-blue-600 rounded-2xl transform -rotate-12"></div>
                    </div>

                    <!-- Central Focus Card -->
                    <div class="relative z-10 bg-white rounded-2xl shadow-2xl p-8 transform hover:scale-105 transition-transform duration-300">
                        <div class="space-y-4">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-purple-600 rounded-full"></div>
                                <div>
                                    <div class="font-semibold text-gray-900">Modern Web Solutions</div>
                                    <div class="text-sm text-gray-500">Built with latest technologies</div>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <div class="h-2 bg-blue-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-blue-600 to-purple-600 rounded-full w-4/5"></div>
                                </div>
                                <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-green-500 to-emerald-500 rounded-full w-3/5"></div>
                                </div>
                                <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-orange-500 to-red-500 rounded-full w-4/6"></div>
                                </div>
                            </div>
                            <div class="flex justify-between text-sm text-gray-600">
                                <span>Performance</span>
                                <span>95%</span>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Elements -->
                    <div class="absolute top-4 right-4 w-16 h-16 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-full opacity-60 animate-bounce"></div>
                    <div class="absolute bottom-4 left-4 w-12 h-12 bg-gradient-to-br from-pink-400 to-rose-500 rounded-full opacity-60 animate-pulse"></div>
                </div>
            </div>
        </div>
    </section>

	    <About />


		
</body>
</html>