---
import { Image } from 'astro:assets';
import "../assets/css/styles.css";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/store/CartDrawer.astro";
import ProductCard from "../components/store/ProductCard.astro";
import { products } from "../data/products";

import image1 from '../assets/images/hero-image-v2.jpg';

// Cooking Videos Data
const cookingVideos = [
    {
        id: 'bkkQLRKoHrI',
        title: 'Delicious Oyster Mushrooms Recipe',
        titleML: 'രുചികരമായ ഓയസ്റ്റർ മഷ്റൂം റെസിപ്പി',
        description: 'Must-try delicious oyster mushroom recipe by Anusithara Vlog',
        descriptionML: 'അനുസിത്താര വ്ലോഗിന്റെ രുചികരമായ ഓയസ്റ്റർ കൂൺ റെസിപ്പി',
        label: 'Malayalam'
    },
    {
        id: 'lDbEHOhiy10',
        title: 'Mushroom Mezhukkupuratti',
        titleML: 'കൂൺ മെഴുക്കുപുരട്ടി',
        description: 'Traditional Kerala style mushroom stir-fry recipe',
        descriptionML: 'പരമ്പരാഗത കേരള സ്റ്റൈൽ കൂൺ മെഴുക്കുപുരട്ടി റെസിപ്പി',
        label: 'Malayalam'
    },
    {
        id: 'GrXU5RMYotE',
        title: 'Mushroom Thoran',
        titleML: 'കൂൺ തോരൻ',
        description: 'Delicious mushroom thoran recipe',
        descriptionML: 'സ്വാദിഷ്ടമായ കൂൺ തോരൻ റെസിപ്പി',
        label: 'Malayalam'
    },
    {
        id: 'WgZUNb2BjCU',
        title: 'Easy Mushroom Masala',
        titleML: 'ലളിതമായ കൂൺ മസാല',
        description: 'Perfect for beginners',
        descriptionML: 'തുടക്കക്കാർക്ക് അനുയോജ്യം',
        label: 'Malayalam'
    },
    {
        id: 'fM83Vo_F_hA',
        title: 'Restaurant Style Mushroom Gravy',
        titleML: 'റെസ്റ്റോറന്റ് സ്റ്റൈൽ കൂൺ ഗ്രേവി',
        description: 'Restaurant taste at home',
        descriptionML: 'റസ്റ്റോറന്റ് രുചിയിൽ വീട്ടിൽ തയ്യാറാക്കാം',
        label: 'Malayalam'
    },
    {
        id: '9OT6AbTeuVI',
        title: 'Quick Mushroom with Rice',
        titleML: 'പെട്ടെന്നൊരു കൂൺ റെസിപ്പി',
        description: 'Perfect quick meal with rice',
        descriptionML: 'ചോറിനൊപ്പം മികച്ചത്',
        label: 'Shorts'
    }
];

// Testimonials Data
const testimonials = [
    {
        quote: "The texture is incredible — just like meat in my curry!",
        name: "Reshma",
        area: "Kozhikode"
    },
    {
        quote: "My kids loved the thoran. We order every week now.",
        name: "Bindu",
        area: "Vadakara"
    },
    {
        quote: "First time trying oyster mushrooms. Totally worth it!",
        name: "Anoop",
        area: "Calicut"
    }
];
---

<Head/>
<CartDrawer />

<!-- 1. Hero Section -->
<section class="min-h-screen pt-28 pb-16 relative overflow-hidden flex items-center bg-[#FDFBF7]">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1586075010923-2dd4570fb338?q=80&w=2000&auto=format&fit=crop&ixlib=rb-4.0.3&blur=100')] opacity-5 z-0"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center w-full">
            <div class="text-center lg:text-left">

                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-stone-900 leading-tight mb-6">
                    <span>Premium Oyster Mushrooms.<br/>Harvested Today.</span>
                </h1>
                <p class="text-lg text-stone-600 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                    Thick, meaty, and cultivated in Vadakara. Taste the difference quality makes.
                </p>

                <!-- Trust Badges -->
                <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-10">
                    <span class="inline-flex items-center gap-2 rounded-full bg-primary-light text-primary px-4 py-1.5 text-xs font-medium">
                        <i class="fas fa-leaf text-[10px]"></i>
                        Indoor Farmed
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-primary-light text-primary px-4 py-1.5 text-xs font-medium">
                        <i class="fas fa-certificate text-[10px]"></i>
                        FSSAI Registered
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-primary-light text-primary px-4 py-1.5 text-xs font-medium">
                        <i class="fas fa-box text-[10px]"></i>
                        Hygienic Packaging
                    </span>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
                    <a href="#store" class="px-8 py-4 bg-primary text-white rounded-full hover:bg-primary-dark transition-all flex items-center justify-center gap-2 font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                        <i class="fab fa-whatsapp text-sm"></i>
                        <span>Order Fresh Now</span>
                    </a>
                    <a href="#videos" class="px-8 py-4 border-2 border-primary text-primary rounded-full hover:bg-primary-light transition-all flex items-center justify-center gap-2 font-semibold bg-transparent">
                        <i class="fas fa-utensils text-sm"></i>
                        <span>Watch Recipes</span>
                    </a>
                </div>
            </div>

            <div class="relative">
                <div class="relative max-w-2xl mx-auto animate-float">
                    <Image src={image1} alt="Fresh Oyster Mushrooms" class="w-full rounded-3xl" widths={[480, 768, 960]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 50vw, 640px" loading="eager" fetchpriority="high" quality={72} />
                </div>
                <div class="absolute top-10 right-10 w-20 h-20 bg-primary-light rounded-full -z-10"></div>
                <div class="absolute bottom-10 left-10 w-32 h-32 bg-primary-light rounded-full -z-10"></div>
            </div>
        </div>
    </div>
</section>

<!-- 2. Why Oyster Mushrooms -->
<section class="py-12 bg-primary text-white overflow-hidden relative">
    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
            <span>Have You Tasted the "Vegetarian Meat"?</span>
        </h2>
        <p class="text-xl md:text-2xl text-white/90 mb-10 font-light max-w-3xl mx-auto">
            Firm, meaty texture, rich umami flavour, and full of nutrition your body actually needs.
        </p>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto border-t border-white/20 pt-10 mt-4">
            <div class="text-center">
                <div class="text-3xl mb-2"><i class="fas fa-bolt text-stone-200"></i></div>
                <div class="font-bold text-lg">Metabolism</div>
                <div class="text-xs text-white/80">B-Vitamin boost for sustained energy</div>
            </div>
             <div class="text-center">
                <div class="text-3xl mb-2"><i class="fas fa-shield-alt text-stone-200"></i></div>
                <div class="font-bold text-lg">Immunity</div>
                <div class="text-xs text-white/80">Beta-glucans for natural defense</div>
            </div>
             <div class="text-center">
                <div class="text-3xl mb-2"><i class="fas fa-brain text-stone-200"></i></div>
                <div class="font-bold text-lg">Brain Power</div>
                <div class="text-xs text-white/80">Neuroprotective compounds</div>
            </div>
             <div class="text-center">
                <div class="text-3xl mb-2"><i class="fas fa-heart text-stone-200"></i></div>
                <div class="font-bold text-lg">Heart Health</div>
                <div class="text-xs text-white/80">Zero cholesterol, heart-friendly</div>
            </div>
        </div>
    </div>
</section>

<!-- 3. Products (Store) -->
<section id="store" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Our Store</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Our Farm Fresh Products</h2>
            <p class="text-stone-600 mb-6">Select your items below. Fast checkout via WhatsApp.</p>
            <!-- Scarcity Badge -->
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary text-white text-xs font-bold tracking-wider uppercase">
                <i class="fas fa-hourglass-half"></i>
                Limited Daily Harvest
            </span>
        </div>

        <!-- How to Order Teaser -->
        <div class="bg-primary-light rounded-2xl p-6 mb-12 text-center border border-primary/10">
            <div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto">
                <div class="flex items-center gap-3 justify-center">
                    <span class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-bold text-sm">1</span>
                    <span class="text-sm font-medium text-stone-700">Add items to cart</span>
                </div>
                <div class="flex items-center gap-3 justify-center">
                    <span class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-bold text-sm">2</span>
                    <span class="text-sm font-medium text-stone-700">Enter delivery details</span>
                </div>
                <div class="flex items-center gap-3 justify-center">
                    <span class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-bold text-sm">3</span>
                    <span class="text-sm font-medium text-stone-700">Order on WhatsApp</span>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {products.map((product) => <ProductCard product={product} />)}
        </div>
    </div>
</section>

<!-- 4. Recipe Videos -->
<section id="videos" class="py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Learn to Cook</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Learn to Cook in Minutes</h2>
            <p class="text-stone-600">Oyster mushrooms hold their shape and absorb Kerala curry flavours perfectly. Watch and cook today.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {cookingVideos.map((video) => (
                <div class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all group">
                    <div class="relative">
                        <img src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`} alt={video.title} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                        <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <i class="fas fa-play text-white text-3xl"></i>
                        </div>
                        <span class="absolute top-4 left-4 text-white text-xs px-2 py-1 rounded" style="background-color: rgba(139, 30, 63, 0.85);" data-ml={video.label}>{video.label}</span>
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-semibold text-stone-900 mb-2" data-ml={video.titleML || video.title}>{video.title}</h3>
                        <p class="text-stone-600 text-sm mb-4">{video.description}</p>
                        <a href={`https://youtube.com/watch?v=${video.id}`} target="_blank" class="inline-flex items-center gap-2 text-primary font-medium hover:text-primary-dark transition-colors">
                            <span>Watch on YouTube</span>
                            <i class="fas fa-external-link-alt text-sm"></i>
                        </a>
                    </div>
                </div>
            ))}
        </div>

        <div class="text-center mt-12">
            <a href="/cooking-videos" class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-white rounded-full hover:bg-primary-dark transition-all group">
                <i class="fab fa-youtube"></i>
                <span>More Cooking Videos</span>
                <i class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- 5. Testimonials -->
<section class="py-20 bg-[#F8FAF8]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Testimonials</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">What Our Customers Say</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {testimonials.map((item) => (
                <div class="bg-white rounded-2xl p-8 border border-stone-200 hover:shadow-lg transition-all">
                    <i class="fas fa-quote-left text-3xl text-primary/30 mb-4"></i>
                    <p class="text-stone-600 text-sm leading-relaxed mb-6 italic">"{item.quote}"</p>
                    <div class="flex items-center gap-3 border-t border-stone-100 pt-4">
                        <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                            <span class="text-primary font-bold text-sm">{item.name.charAt(0)}</span>
                        </div>
                        <div>
                            <p class="font-semibold text-stone-900 text-sm">{item.name}</p>
                            <p class="text-xs text-stone-500">{item.area}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- 6. Health Benefits (Zigzag) -->
<section class="py-20 bg-stone-50">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Health Benefits</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">
                <span>Discover the Benefits of Oyster Mushrooms</span>
            </h2>
            <p class="text-stone-600 mb-4">Packed with nutrition and scientifically proven health benefits.</p>
        </div>

        <div class="space-y-12">
            
            <!-- Row 1: Icon Left, Text Right -->
            <div class="grid md:grid-cols-2 gap-8 items-center">
                <div class="bg-white rounded-2xl p-8 border border-primary/10 text-center md:text-left">
                    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4 mx-auto md:mx-0">
                        <i class="fas fa-shield-virus text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-xl font-bold text-stone-900 mb-2">Immune System Support</h3>
                    <p class="text-stone-600 text-sm">Rich in beta-glucans for healthy immune function.</p>
                </div>
                <div class="bg-white rounded-2xl p-8 border border-primary/10 text-center md:text-left">
                    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4 mx-auto md:mx-0">
                        <i class="fas fa-dumbbell text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-xl font-bold text-stone-900 mb-2">High in Protein</h3>
                    <p class="text-stone-600 text-sm">Great plant-based protein for everyday nutrition.</p>
                </div>
            </div>

            <!-- Row 2: Text Left, Icon Right -->
            <div class="grid md:grid-cols-2 gap-8 items-center">
                <div class="bg-white rounded-2xl p-8 border border-primary/10 text-center md:text-left md:order-2">
                    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4 mx-auto md:mx-0">
                        <i class="fas fa-sun text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-xl font-bold text-stone-900 mb-2">Naturally Rich in Vitamin D</h3>
                    <p class="text-stone-600 text-sm">One of the few natural food sources of Vitamin D.</p>
                </div>
                <div class="bg-white rounded-2xl p-8 border border-primary/10 text-center md:text-left md:order-1">
                    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4 mx-auto md:mx-0">
                        <i class="fas fa-heart text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-xl font-bold text-stone-900 mb-2">Heart-Friendly Nutrition</h3>
                    <p class="text-stone-600 text-sm">Supports healthy cholesterol levels.</p>
                </div>
            </div>

            <!-- Row 3: Icon Left, Text Right -->
            <div class="grid md:grid-cols-2 gap-8 items-center">
                <div class="bg-white rounded-2xl p-8 border border-primary/10 text-center md:text-left">
                    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4 mx-auto md:mx-0">
                        <i class="fas fa-brain text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-xl font-bold text-stone-900 mb-2">Brain Health</h3>
                    <p class="text-stone-600 text-sm">Antioxidants linked to cognitive health.</p>
                </div>
                <div class="bg-white rounded-2xl p-8 border border-primary/10 text-center md:text-left">
                    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4 mx-auto md:mx-0">
                        <i class="fas fa-seedling text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-xl font-bold text-stone-900 mb-2">Gut Health & Digestion</h3>
                    <p class="text-stone-600 text-sm">Rich dietary fiber for healthy digestion.</p>
                </div>
            </div>

            <!-- Row 4: Text Left, Icon Right -->
            <div class="grid md:grid-cols-2 gap-8 items-center">
                <div class="bg-white rounded-2xl p-8 border border-primary/10 text-center md:text-left md:order-2">
                    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4 mx-auto md:mx-0">
                        <i class="fas fa-fire text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-xl font-bold text-stone-900 mb-2">Low-Calorie Superfood</h3>
                    <p class="text-stone-600 text-sm">Nutrient-dense, ideal for healthy meals.</p>
                </div>
                <div class="bg-white rounded-2xl p-8 border border-primary/10 text-center md:text-left md:order-1">
                    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4 mx-auto md:mx-0">
                        <i class="fas fa-star text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-xl font-bold text-stone-900 mb-2">Antioxidant Rich</h3>
                    <p class="text-stone-600 text-sm">Fights oxidative stress naturally.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- 7. The Meaty Difference (Compact Banner) -->
<section class="py-14 bg-primary text-white">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-10">
            <h2 class="text-2xl md:text-3xl font-bold">The Meaty Mushrooms Difference</h2>
            <p class="text-white/80 mt-2 text-sm">Why customers choose us</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <div class="text-center">
                <i class="fas fa-leaf text-2xl text-stone-200 mb-2"></i>
                <p class="font-semibold text-sm">100% Organic</p>
                <p class="text-xs text-white/70 mt-1">Pesticide-free</p>
            </div>
            <div class="text-center">
                <i class="fas fa-clock text-2xl text-stone-200 mb-2"></i>
                <p class="font-semibold text-sm">Same Day Delivery</p>
                <p class="text-xs text-white/70 mt-1">Farm to kitchen</p>
            </div>
            <div class="text-center">
                <i class="fas fa-flask text-2xl text-stone-200 mb-2"></i>
                <p class="font-semibold text-sm">Lab Tested</p>
                <p class="text-xs text-white/70 mt-1">Quality checked</p>
            </div>
            <div class="text-center">
                <i class="fas fa-handshake text-2xl text-stone-200 mb-2"></i>
                <p class="font-semibold text-sm">Locally Grown</p>
                <p class="text-xs text-white/70 mt-1">Vadakara, Kerala</p>
            </div>
        </div>
    </div>
</section>

<!-- 8. Safety & Certifications -->
<section id="safety" class="py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Safety & Quality</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Grown Safely in Kerala</h2>
            <p class="text-stone-600">Our commitment to quality and safety standards you can trust.</p>
        </div>

        <!-- Certifications -->
        <div class="grid md:grid-cols-2 gap-8 mb-16">
            <div class="bg-[#F8FAF8] rounded-2xl p-8 text-center hover:shadow-xl transition-all duration-300 border border-primary/10">
                <div class="w-20 h-20 bg-primary/5 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-certificate text-primary text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-2">FSSAI Registered</h3>
                <p class="text-primary font-mono text-lg font-bold tracking-wider mb-3">21325234000380</p>
                <p class="text-sm text-stone-600">Registered with Food Safety and Standards Authority of India.</p>
            </div>
            <div class="bg-[#F8FAF8] rounded-2xl p-8 text-center hover:shadow-xl transition-all duration-300 border border-primary/10">
                <div class="w-20 h-20 bg-primary/5 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-industry text-primary text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-2">MSME Registered</h3>
                <p class="text-primary font-mono text-lg font-bold tracking-wider mb-3">UDYAM-KL-08-0086495</p>
                <p class="text-sm text-stone-600">Registered under Micro, Small & Medium Enterprises Development Act.</p>
            </div>
        </div>

        <!-- Storage & Handling: 2 Side-by-Side Cards -->
        <div class="grid md:grid-cols-2 gap-8 mb-16">
            <!-- Card 1: Storage Rules -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10">
                <h3 class="text-xl font-bold text-stone-900 mb-6 flex items-center gap-3">
                    <span class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center"><i class="fas fa-snowflake text-primary"></i></span>
                    <span>Storage Rules</span>
                </h3>
