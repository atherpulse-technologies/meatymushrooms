---
import { Image } from 'astro:assets';
import "../assets/css/styles.css";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";

import image1 from '../assets/images/image1.webp';
import banner from '../assets/images/banner.jpg';
import image2 from '../assets/images/image2.webp';  
import buttonmush from '../assets/images/button.jpg';
import oyster from '../assets/images/oyster.jpg';
import pink from '../assets/images/pink.jpg';

// Cooking Videos Data
const cookingVideos = [
    {
        id: 'bkkQLRKoHrI',
        title: 'Delicious Oyster Mushrooms Recipe',
        description: 'കൂൺ - Must-try delicious oyster mushroom recipe by Anusithara Vlog',
        label: 'Malayalam'
    },
    {
        id: 'lDbEHOhiy10',
        title: 'Mushroom Mezhukkupuratti',
        description: 'മെഴുക്കുപുരട്ടി - Traditional Kerala style mushroom stir-fry recipe',
        label: 'Malayalam'
    },
    {
        id: 'GrXU5RMYotE',
        title: 'Mushroom Thoran',
        description: 'ചിപ്പിക്കൂൺ കൊണ്ട് രുചികരമായ ഒരു തോരൻ - Delicious mushroom thoran recipe',
        label: 'Malayalam'
    },
    {
        id: 'WgZUNb2BjCU',
        title: 'Easy Mushroom Masala',
        description: 'വളരെപ്പെട്ടന്ന് ഉണ്ടാക്കാവുന്ന ഒരു കൂൺ മസാല - Perfect for beginners',
        label: 'Malayalam'
    },
    {
        id: 'fM83Vo_F_hA',
        title: 'Restaurant Style Mushroom Gravy',
        description: 'കൂൺ ഗ്രേവി - റസ്റ്റോറന്റ് രുചിയിൽ വീട്ടിൽ തയ്യാറാക്കാം',
        label: 'Malayalam'
    },
    {
        id: '9OT6AbTeuVI',
        title: 'Quick Mushroom Recipe',
        description: 'കൊറച്ചു ചിപ്പി കൂൺ കിട്ടിയട്ടുണ്ട് - Perfect with rice',
        label: 'Shorts'
    }
];

// Recipes Data
const recipes = [
    {
        name: 'Mushroom Biryani',
        description: 'Aromatic basmati rice cooked with tender mushrooms and traditional spices.',
        image: oyster,
        cookTime: '45 min',
        difficulty: 'Medium',
        cuisine: 'Indian',
        rating: 5,
        reviews: 24,
        link: '/recipes#mushroom-biryani'
    },
    {
        name: 'Creamy Mushroom Soup',
        description: 'Rich and creamy soup perfect for cold evenings with fresh herbs.',
        image: pink,
        cookTime: '25 min',
        difficulty: 'Easy',
        cuisine: 'Continental',
        rating: 4,
        reviews: 18,
        link: '/recipes#mushroom-soup'
    },
    {
        name: 'Quick Mushroom Stir Fry',
        description: 'Fast and healthy stir-fry with colorful vegetables and savory sauce.',
        image: buttonmush,
        cookTime: '15 min',
        difficulty: 'Easy',
        cuisine: 'Asian',
        rating: 5,
        reviews: 31,
        link: '/recipes#mushroom-stir-fry'
    }
];

// Products Data
const products = [
    {
        name: 'Pearl Oyster Mushrooms',
        description: 'Fresh, tender, and perfect for stir-fries and curries. Rich in proteins and minerals.',
        image: oyster,
        price: '₹60/250g',
        badge: 'Best Seller',
        badgeColor: 'bg-[#3A493E]'
    },
    {
        name: 'Pink Oyster Mushrooms',
        description: 'Visually stunning with a delicate seafood-like flavor. Perfect for gourmet dishes.',
        image: pink,
        price: '₹80/250g',
        badge: 'New',
        badgeColor: 'bg-[#D87D88]'
    },
    {
        name: 'Mushroom Powder',
        description: '100% pure mushroom powder. Add to smoothies, soups, and dishes for extra nutrition.',
        image: buttonmush,
        price: '₹120/100g',
        badge: 'Popular',
        badgeColor: 'bg-[#3A493E]'
    }
];
---

<Head/>

<!-- Product Welcome Section (New QR Code focused) -->
<section class="min-h-screen pt-28 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1586075010923-2dd4570fb338?q=80&w=2000&auto=format&fit=crop&ixlib=rb-4.0.3&blur=100')] opacity-5 z-0"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="text-center lg:text-left" data-aos="fade-right">
                <span class="inline-block px-4 py-2 rounded-full bg-[#E9F0EA] text-[#3A493E] text-sm font-medium mb-6">
                    🍄 Welcome to Your Mushroom Guide
                </span>
                <h1 class="text-4xl md:text-6xl font-bold text-stone-900 leading-tight mb-6">
                    Fresh Mushrooms, <br>
                    Harvested Daily from 
                    <span class="text-[#3A493E]">Vadakara</span>
                </h1>
                <p class="text-lg text-stone-600 mb-8 max-w-xl mx-auto lg:mx-0">
                    From cooking tips to nutritional benefits - your complete guide to making the most of your premium organic mushrooms.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="#cooking-videos" class="px-8 py-4 bg-[#3A493E] text-white rounded-full hover:bg-[#2C3A30] transition-all flex items-center justify-center gap-2 group">
                        Watch Cooking Videos
                        <i class="fas fa-play text-sm"></i>
                    </a>
                    <a href="#recipes" class="px-8 py-4 border-2 border-[#3A493E] text-[#3A493E] rounded-full hover:bg-[#E9F0EA] transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-book-open"></i>
                        View Recipes
                    </a>
                </div>

                <!-- Trust Badges -->
                <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-2xl mx-auto lg:mx-0">
                    <div class="text-center" data-aos="fade-up" data-aos-delay="100">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">100%</h3>
                        <p class="text-sm text-stone-600">Organic</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="200">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">50kg+</h3>
                        <p class="text-sm text-stone-600">Daily Harvest</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="300">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">1000+</h3>
                        <p class="text-sm text-stone-600">Happy Customers</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="400">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">5+</h3>
                        <p class="text-sm text-stone-600">Varieties</p>
                    </div>
                </div>
            </div>

            <div class="relative" data-aos="fade-left">
                <Image src={image1} alt="Fresh Oyster Mushrooms" class="w-full max-w-2xl mx-auto animate-float" />
                <div class="absolute top-10 right-10 w-20 h-20 bg-[#E9F0EA] rounded-full -z-10"></div>
                <div class="absolute bottom-10 left-10 w-32 h-32 bg-[#E9F0EA] rounded-full -z-10"></div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Navigation (New) -->
<section class="py-12 bg-[#F8FAF8]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <a href="#cooking-videos" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-video text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900">Cooking Videos</h3>
            </a>
            <a href="/recipes" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-utensils text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900">Recipes</h3>
            </a>
            <a href="#nutrition" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-leaf text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900">Nutrition Facts</h3>
            </a>
            <a href="#safety" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-shield-alt text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900">Food Safety</h3>
            </a>
        </div>
    </div>
</section>

<!-- Cooking Videos Section -->
<section id="cooking-videos" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-[#3A493E] tracking-wider uppercase block mb-3">Learn to Cook</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Cooking Videos & Tutorials</h2>
            <p class="text-stone-600">Master the art of cooking mushrooms with our expert video guides in Malayalam.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {cookingVideos.map((video, index) => (
                <div class="bg-[#F8FAF8] rounded-2xl overflow-hidden hover:shadow-xl transition-all group" data-aos="fade-up" data-aos-delay={index * 100}>
                    <div class="relative">
                        <img src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`} alt={video.title} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                        <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <i class="fas fa-play text-white text-3xl"></i>
                        </div>
                        <span class="absolute top-4 left-4 bg-red-600 text-white text-xs px-2 py-1 rounded">{video.label}</span>
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-semibold text-stone-900 mb-2">{video.title}</h3>
                        <p class="text-stone-600 text-sm mb-4">{video.description}</p>
                        <a href={`https://youtube.com/watch?v=${video.id}`} target="_blank" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors">
                            Watch on YouTube
                            <i class="fas fa-external-link-alt text-sm"></i>
                        </a>
                    </div>
                </div>
            ))}
        </div>

        <div class="text-center mt-12">

            <a href="/cooking-videos" class="inline-flex items-center gap-2 px-8 py-4 bg-red-600 text-white rounded-full hover:bg-red-700 transition-all group">
                <i class="fab fa-youtube"></i>
                More Cooking Videos
                <i class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- Recipes Section (Redesigned - Fresh & Minimal) -->
<section id="recipes" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-[#3A493E] tracking-wider uppercase block mb-3">Recipe Collection</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Simple. Delicious. Healthy.</h2>
            <p class="text-stone-600">Three carefully curated recipes to get you started with mushroom cooking.</p>
        </div>

        <div class="grid lg:grid-cols-3 gap-12">
            {recipes.map((recipe, index) => (
                <div class="group cursor-pointer" data-aos="fade-up" data-aos-delay={index * 150}>
                    <div class="relative mb-8 overflow-hidden rounded-3xl">
                        <Image src={recipe.image} alt={recipe.name} class="w-full h-80 object-cover group-hover:scale-110 transition-transform duration-700" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent group-hover:from-black/40 transition-all duration-500"></div>
                        <div class="absolute bottom-6 left-6 right-6 text-white">
                            <div class="flex items-center gap-4 mb-3">
                                <span class="text-sm bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full">{recipe.cuisine}</span>
                                <span class="text-sm bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full">{recipe.cookTime}</span>
                            </div>
                            <h3 class="text-2xl font-bold mb-2">{recipe.name}</h3>
                            <div class="flex items-center gap-1 text-yellow-400">
                                {Array(recipe.rating).fill(0).map(() => (
                                    <i class="fas fa-star text-sm"></i>
                                ))}
                                <span class="text-white/80 ml-2 text-sm">({recipe.reviews} reviews)</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <p class="text-stone-600 leading-relaxed">{recipe.description}</p>
                        
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-4 text-sm text-stone-500">
                                <span class="flex items-center gap-1">
                                    <i class="fas fa-signal"></i>
                                    {recipe.difficulty}
                                </span>
                                <span class="flex items-center gap-1">
                                    <i class="fas fa-users"></i>
                                    Serves 4
                                </span>
                            </div>
                            <a href={`/recipes/recipe-${index + 1}`} class="text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors group-hover:underline">
                                View Recipe →
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <div class="text-center mt-16">
            <a href="/recipes" class="inline-flex items-center gap-3 px-8 py-4 border border-[#3A493E] text-[#3A493E] rounded-full hover:bg-[#3A493E] hover:text-white transition-all group">
                Browse All Recipes
                <i class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- Featured Products Section -->
<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-[#3A493E] tracking-wider uppercase block mb-3">Our Products</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Premium Mushroom Varieties</h2>
            <p class="text-stone-600">Discover our range of premium organic mushrooms, harvested daily to ensure maximum freshness and nutrition.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map((product, index) => (
                <div class="bg-white rounded-2xl p-6 group hover:shadow-xl transition-all duration-300 border border-stone-100" data-aos="fade-up" data-aos-delay={index * 100}>
                    <div class="relative mb-6 overflow-hidden rounded-xl">
                        <Image src={product.image} alt={product.name} class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300" />
                        <span class={`absolute top-4 right-4 ${product.badgeColor} text-white text-sm px-3 py-1 rounded-full`}>{product.badge}</span>
                    </div>
                    <h3 class="text-xl font-semibold text-stone-900 mb-2">{product.name}</h3>
                    <p class="text-stone-600 text-sm mb-4">{product.description}</p>
                    <div class="flex items-center justify-between">
                        <span class="text-[#3A493E] font-semibold">{product.price}</span>
                        <button class="px-4 py-2 bg-[#E9F0EA] text-[#3A493E] rounded-full hover:bg-[#3A493E] hover:text-white transition-all flex items-center gap-2 text-sm">
                            <i class="fas fa-shopping-basket"></i>
                            Add to Cart
                        </button>
                    </div>
                </div>
            ))}
        </div>

        <div class="text-center mt-12">
            <a href="/products" class="inline-flex items-center gap-2 text-[#3A493E] font-medium hover:text-[#2C3A30] transition-colors group">
                View All Products
                <i class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- Nutritional Facts Section (Redesigned with better layout) -->
<section id="nutrition" class="py-20 bg-[#F8FAF8]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-sm font-medium text-[#3A493E] tracking-wider uppercase block mb-3">Health Benefits</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Complete Nutritional Facts</h2>
            <p class="text-stone-600 mb-4">Per 100g fresh weight - Discover the incredible health benefits and complete nutritional profile.</p>
            <div class="inline-block bg-white px-4 py-2 rounded-lg border border-[#3A493E]/20">
                <p class="text-sm text-[#3A493E] font-medium">
                    <span class="font-semibold">RDA</span> = Recommended Daily Allowance for adults
                </p>
            </div>
        </div>

        <!-- Main Nutritional Grid -->
        <div class="grid lg:grid-cols-2 gap-8 mb-12">
            <!-- Left Column: Macronutrients & Vitamins -->
            <div class="space-y-8">
                <!-- Macronutrients -->
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-[#3A493E]/10">
                    <h3 class="text-2xl font-bold text-stone-900 mb-6 flex items-center gap-3">
                        <div class="w-10 h-10 bg-[#3A493E]/10 rounded-full flex items-center justify-center">
                            <span class="text-xl">🧪</span>
                        </div>
                        Macronutrients
                    </h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-2xl font-bold text-[#3A493E] mb-1">33</div>
                            <div class="text-sm text-stone-600 mb-1">Calories (kcal)</div>
                            <div class="text-xs text-[#3A493E]/70">2% RDA</div>
                        </div>
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-2xl font-bold text-[#3A493E] mb-1">3.3g</div>
                            <div class="text-sm text-stone-600 mb-1">Protein</div>
                            <div class="text-xs text-[#3A493E]/70">7% RDA</div>
                        </div>
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-2xl font-bold text-[#3A493E] mb-1">0.4g</div>
                            <div class="text-sm text-stone-600 mb-1">Total Fat</div>
                            <div class="text-xs text-[#3A493E]/70">1% RDA</div>
                        </div>
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-2xl font-bold text-[#3A493E] mb-1">6.1g</div>
                            <div class="text-sm text-stone-600 mb-1">Carbohydrates</div>
                            <div class="text-xs text-[#3A493E]/70">2% RDA</div>
                        </div>
                    </div>
                    <div class="mt-4 grid grid-cols-2 gap-4">
                        <div class="bg-[#3A493E]/3 p-3 rounded-lg">
                            <div class="text-lg font-semibold text-[#3A493E]">2.3g</div>
                            <div class="text-xs text-stone-600">Dietary Fiber (9% RDA)</div>
                        </div>
                        <div class="bg-[#3A493E]/3 p-3 rounded-lg">
                            <div class="text-lg font-semibold text-[#3A493E]">1.1g</div>
                            <div class="text-xs text-stone-600">Natural Sugar</div>
                        </div>
                    </div>
                </div>

                <!-- Key Vitamins -->
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-[#3A493E]/10">
                    <h3 class="text-2xl font-bold text-stone-900 mb-6 flex items-center gap-3">
                        <div class="w-10 h-10 bg-[#3A493E]/10 rounded-full flex items-center justify-center">
                            <span class="text-xl">🌿</span>
                        </div>
                        Key Vitamins
                    </h3>
                    <div class="space-y-4">
                        <div class="bg-[#3A493E]/10 p-4 rounded-xl border border-[#3A493E]/20">
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-semibold text-[#3A493E] mb-1">Vitamin D2</div>
                                    <div class="text-sm text-stone-600">0.5-4.9µg</div>
                                </div>
                                <div class="text-right">
                                    <div class="text-lg font-bold text-[#3A493E]">20-200%</div>
                                    <div class="text-xs text-[#3A493E]/70">RDA</div>
                                </div>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-[#3A493E]/5 p-3 rounded-lg">
                                <div class="text-sm font-medium text-stone-700">Vitamin B2</div>
                                <div class="text-[#3A493E] font-semibold">27% RDA</div>
                            </div>
                            <div class="bg-[#3A493E]/5 p-3 rounded-lg">
                                <div class="text-sm font-medium text-stone-700">Vitamin B3</div>
                                <div class="text-[#3A493E] font-semibold">31% RDA</div>
                            </div>
                            <div class="bg-[#3A493E]/5 p-3 rounded-lg">
                                <div class="text-sm font-medium text-stone-700">Vitamin B5</div>
                                <div class="text-[#3A493E] font-semibold">26% RDA</div>
                            </div>
                            <div class="bg-[#3A493E]/5 p-3 rounded-lg">
                                <div class="text-sm font-medium text-stone-700">Folate (B9)</div>
                                <div class="text-[#3A493E] font-semibold">10% RDA</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Minerals & Bioactive Compounds -->
            <div class="space-y-8">
                <!-- Essential Minerals -->
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-[#3A493E]/10">
                    <h3 class="text-2xl font-bold text-stone-900 mb-6 flex items-center gap-3">
                        <div class="w-10 h-10 bg-[#3A493E]/10 rounded-full flex items-center justify-center">
                            <span class="text-xl">💪</span>
                        </div>
                        Essential Minerals
                    </h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-lg font-bold text-[#3A493E] mb-1">361mg</div>
                            <div class="text-sm text-stone-600 mb-1">Potassium</div>
                            <div class="text-xs text-[#3A493E]/70">10% RDA</div>
                        </div>
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
