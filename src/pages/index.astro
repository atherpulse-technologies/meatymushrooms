---


<Head/>

<!-- Product Welcome Section -->
<section class="min-h-screen pt-48 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1586075010923-2dd4570fb338?q=80&w=2000&auto=format&fit=crop&ixlib=rb-4.0.3&blur=100')] opacity-5 z-0"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="text-center lg:text-left" data-aos="fade-right">

                <h1 class="text-4xl md:text-5xl font-bold text-stone-900 leading-tight mb-6">
                    <span data-ml="ഫ്രഷ് കൂണുകൾ,">Fresh Mushrooms,</span> <br>
                    <span data-ml="ദിവസവും വിളവെടുക്കുന്നത്">Harvested Daily from</span> 
                    <span class="text-[#3A493E]" data-ml="വടകരയിൽ നിന്ന്">Vadakara</span>
                </h1>
                <p class="text-lg text-stone-600 mb-8 max-w-xl mx-auto lg:mx-0" data-ml="പാചക കുറിപ്പുകൾ മുതൽ പോഷക ഗുണങ്ങൾ വരെ - നിങ്ങളുടെ പ്രീമിയം ഓർഗാനിക് കൂണുകൾ പരമാവധി പ്രയോജനപ്പെടുത്തുന്നതിനുള്ള പൂർണ്ണമായ ഗൈഡ്.">
                    From cooking tips to nutritional benefits - your complete guide to making the most of your premium organic mushrooms.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="/products" class="px-8 py-4 bg-[#3A493E] text-white rounded-full hover:bg-[#2C3A30] transition-all flex items-center justify-center gap-2 group shadow-lg hover:shadow-xl hover:-translate-y-1">
                        <span data-ml="ഇപ്പോൾ ഓർഡർ ചെയ്യൂ">Order Now</span>
                        <i class="fas fa-shopping-basket text-sm"></i>
                    </a>
                    <a href="#cooking-videos" class="px-8 py-4 border-2 border-[#3A493E] text-[#3A493E] rounded-full hover:bg-[#E9F0EA] transition-all flex items-center justify-center gap-2">
                        <span data-ml="പാചക വീഡിയോകൾ">Watch Videos</span>
                        <i class="fas fa-play text-sm"></i>
                    </a>
                </div>

                <!-- Trust Badges -->
                <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-2xl mx-auto lg:mx-0">
                    <div class="text-center" data-aos="fade-up" data-aos-delay="100">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">100%</h3>
                        <p class="text-sm text-stone-600" data-ml="ഓർഗാനിക്">Organic</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="200">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">10kg+</h3>
                        <p class="text-sm text-stone-600" data-ml="ദിവസവും വിളവെടുപ്പ്">Daily Harvest</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="300">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">100+</h3>
                        <p class="text-sm text-stone-600" data-ml="സന്തുഷ്ടരായ ഉപഭോക്താക്കൾ">Happy Customers</p>
                    </div>
                    <div class="text-center" data-aos="fade-up" data-aos-delay="400">
                        <h3 class="text-3xl font-bold text-[#3A493E] mb-1">4.9</h3>
                        <p class="text-sm text-stone-600" data-ml="റേറ്റിംഗ്">Star Rating</p>
                    </div>
                </div>
            </div>

            <div class="relative" data-aos="fade-left">
                <div class="relative max-w-2xl mx-auto animate-float">
                    <Image src={image1} alt="Fresh Oyster Mushrooms" class="w-full rounded-3xl" />
                    <div class="absolute bottom-8 right-0 md:-right-8 z-20 bg-white/90 backdrop-blur-sm py-3 px-6 rounded-2xl shadow-lg border border-[#3A493E]/10 flex flex-col items-start text-left min-w-[200px]">
                        <p class="text-lg font-bold text-[#3A493E]" data-ml="ബിന്ദു എൻ കെ">Bindu N K</p>
                        <p class="text-sm text-stone-600" data-ml="ഉടമ, മീറ്റി മഷ്റൂംസ്">Proprietor, Meaty Mushrooms</p>
                    </div>
                </div>
                <div class="absolute top-10 right-10 w-20 h-20 bg-[#E9F0EA] rounded-full -z-10"></div>
                <div class="absolute bottom-10 left-10 w-32 h-32 bg-[#E9F0EA] rounded-full -z-10"></div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Navigation -->
<section class="py-12 bg-[#F8FAF8]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
             <a href="#nutrition" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-leaf text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900" data-ml="പോഷക ഗുണങ്ങൾ">Nutrition Facts</h3>
            </a>
            <a href="#cooking-videos" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-video text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900" data-ml="പാചക വീഡിയോകൾ">Cooking Videos</h3>
            </a>
            <a href="/recipes" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-utensils text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900" data-ml="റെസിപ്പികൾ">Recipes</h3>
            </a>
            <a href="#safety" class="bg-white p-6 rounded-xl text-center hover:shadow-lg transition-all group">
                <i class="fas fa-shield-alt text-3xl text-[#3A493E] mb-3 group-hover:scale-110 transition-transform"></i>
                <h3 class="font-semibold text-stone-900" data-ml="ഭക്ഷ്യ സുരക്ഷ">Food Safety</h3>
            </a>
        </div>
    </div>
</section>

<Solutions />

<!-- Nutritional Facts Section (Restored Detailed Version) -->
<section id="nutrition" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-sm font-medium text-[#3A493E] tracking-wider uppercase block mb-3" data-ml="ആരോഗ്യ ഗുണങ്ങൾ">Health Benefits</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6" data-ml="പൂർണ്ണമായ പോഷക വിവരങ്ങൾ">Complete Nutritional Facts</h2>
            <p class="text-stone-600 mb-4" data-ml="100 ഗ്രാം ഫ്രഷ് കൂണിലെ പോഷക ഗുണങ്ങൾ">Per 100g fresh weight - Discover the incredible health benefits and complete nutritional profile.</p>
            <div class="inline-block bg-white px-4 py-2 rounded-lg border border-[#3A493E]/20">
                <p class="text-sm text-[#3A493E] font-medium">
                    <span class="font-semibold">RDA</span> = Recommended Daily Allowance for adults
                </p>
            </div>
        </div>

        <!-- Main Nutritional Grid -->
        <div class="grid lg:grid-cols-2 gap-8 mb-12">
            <!-- Left Column: Macronutrients & Vitamins -->
            <div class="space-y-8">
                <!-- Macronutrients -->
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-[#3A493E]/10">
                    <h3 class="text-2xl font-bold text-stone-900 mb-6 flex items-center gap-3">
                        <div class="w-10 h-10 bg-[#3A493E]/10 rounded-full flex items-center justify-center">
                            <span class="text-xl">🧪</span>
                        </div>
                        <span data-ml="മാക്രോന്യൂട്രിയന്റുകൾ">Macronutrients</span>
                    </h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-2xl font-bold text-[#3A493E] mb-1">33</div>
                            <div class="text-sm text-stone-600 mb-1" data-ml="കലോറി">Calories (kcal)</div>
                            <div class="text-xs text-[#3A493E]/70">2% RDA</div>
                        </div>
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-2xl font-bold text-[#3A493E] mb-1">3.3g</div>
                            <div class="text-sm text-stone-600 mb-1" data-ml="പ്രോട്ടീൻ">Protein</div>
                            <div class="text-xs text-[#3A493E]/70">7% RDA</div>
                        </div>
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-2xl font-bold text-[#3A493E] mb-1">0.4g</div>
                            <div class="text-sm text-stone-600 mb-1" data-ml="കൊഴുപ്പ്">Total Fat</div>
                            <div class="text-xs text-[#3A493E]/70">1% RDA</div>
                        </div>
                        <div class="bg-[#3A493E]/5 p-4 rounded-xl">
                            <div class="text-2xl font-bold text-[#3A493E] mb-1">6.1g</div>
                            <div class="text-sm text-stone-600 mb-1" data-ml="കാർബോഹൈഡ്രേറ്റ്">Carbohydrates</div>
                            <div class="text-xs text-[#3A493E]/70">2% RDA</div>
                        </div>
                    </div>
                    <div class="mt-4 grid grid-cols-2 gap-4">
                        <div class="bg-[#3A493E]/3 p-3 rounded-lg">
                            <div class="text-lg font-semibold text-[#3A493E]">2.3g</div>
                            <div class="text-xs text-stone-600" data-ml="നാരുകൾ">Dietary Fiber (9% RDA)</div>
                        </div>
                        <div class="bg-[#3A493E]/3 p-3 rounded-lg">
                            <div class="text-lg font-semibold text-[#3A493E]">1.1g</div>
                            <div class="text-xs text-stone-600" data-ml="പ്രകൃതിദത്ത പഞ്ചസാര">Natural Sugar</div>
                        </div>
                    </div>
                </div>

                <!-- Key Vitamins -->
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-[#3A493E]/10">
                    <h3 class="text-2xl font-bold text-stone-900 mb-6 flex items-center gap-3">
                        <div class="w-10 h-10 bg-[#3A493E]/10 rounded-full flex items-center justify-center">
                            <span class="text-xl">🌿</span>
                        </div>
                        <span data-ml="പ്രധാന വിറ്റാമിനുകൾ">Key Vitamins</span>
                    </h3>
                    <div class="space-y-4">
                        <div class="bg-[#3A493E]/10 p-4 rounded-xl border border-[#3A493E]/20">
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-semibold text-[#3A493E] mb-1" data-ml="വിറ്റാമിൻ ഡി2">Vitamin D2</div>
