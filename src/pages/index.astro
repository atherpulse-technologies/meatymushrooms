---
import { Image } from 'astro:assets';
import "../assets/css/styles.css";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/store/CartDrawer.astro";
import ProductCard from "../components/store/ProductCard.astro";
import { products } from "../data/products";

import image1 from '../assets/images/hero-image-v2.jpg';

// Cooking Videos Data
const cookingVideos = [
    {
        id: 'bkkQLRKoHrI',
        title: 'Delicious Oyster Mushrooms Recipe',
        titleML: 'രുചികരമായ ഓയസ്റ്റർ മഷ്റൂം റെസിപ്പി',
        description: 'Must-try delicious oyster mushroom recipe by Anusithara Vlog',
        descriptionML: 'അനുസിത്താര വ്ലോഗിന്റെ രുചികരമായ ഓയസ്റ്റർ കൂൺ റെസിപ്പി',
        label: 'Malayalam'
    },
    {
        id: 'lDbEHOhiy10',
        title: 'Mushroom Mezhukkupuratti',
        titleML: 'കൂൺ മെഴുക്കുപുരട്ടി',
        description: 'Traditional Kerala style mushroom stir-fry recipe',
        descriptionML: 'പരമ്പരാഗത കേരള സ്റ്റൈൽ കൂൺ മെഴുക്കുപുരട്ടി റെസിപ്പി',
        label: 'Malayalam'
    },
    {
        id: 'GrXU5RMYotE',
        title: 'Mushroom Thoran',
        titleML: 'കൂൺ തോരൻ',
        description: 'Delicious mushroom thoran recipe',
        descriptionML: 'സ്വാദിഷ്ടമായ കൂൺ തോരൻ റെസിപ്പി',
        label: 'Malayalam'
    },
    {
        id: 'WgZUNb2BjCU',
        title: 'Easy Mushroom Masala',
        titleML: 'ലളിതമായ കൂൺ മസാല',
        description: 'Perfect for beginners',
        descriptionML: 'തുടക്കക്കാർക്ക് അനുയോജ്യം',
        label: 'Malayalam'
    },
    {
        id: 'fM83Vo_F_hA',
        title: 'Restaurant Style Mushroom Gravy',
        titleML: 'റെസ്റ്റോറന്റ് സ്റ്റൈൽ കൂൺ ഗ്രേവി',
        description: 'Restaurant taste at home',
        descriptionML: 'റസ്റ്റോറന്റ് രുചിയിൽ വീട്ടിൽ തയ്യാറാക്കാം',
        label: 'Malayalam'
    },
    {
        id: '9OT6AbTeuVI',
        title: 'Quick Mushroom with Rice',
        titleML: 'പെട്ടെന്നൊരു കൂൺ റെസിപ്പി',
        description: 'Perfect quick meal with rice',
        descriptionML: 'ചോറിനൊപ്പം മികച്ചത്',
        label: 'Shorts'
    }
];
---

<Head/>
<CartDrawer />

<!-- Hero Section -->
<section class="min-h-screen pt-48 pb-8 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1586075010923-2dd4570fb338?q=80&w=2000&auto=format&fit=crop&ixlib=rb-4.0.3&blur=100')] opacity-5 z-0"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="text-center lg:text-left">

                <h1 class="text-4xl md:text-5xl font-bold text-stone-900 leading-tight mb-6">
                    <span>Fresh Oyster Mushrooms, Harvested Daily in Vadakara</span>
                </h1>
                <p class="text-lg text-stone-600 mb-8 max-w-xl mx-auto lg:mx-0">
                    Taste the healthy "vegetarian meat." Farm-fresh and delivered straight to your kitchen.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="#store" class="px-8 py-4 bg-primary text-white rounded-full hover:bg-primary-dark transition-all flex items-center justify-center gap-2 group shadow-lg hover:shadow-xl hover:-translate-y-1">
                        <span>Order Fresh Now</span>
                        <i class="fas fa-shopping-basket text-sm"></i>
                    </a>
                    <a href="#videos" class="px-8 py-4 border-2 border-primary text-primary rounded-full hover:bg-primary-light transition-all flex items-center justify-center gap-2">
                        <span>Watch Recipes</span>
                        <i class="fas fa-play text-sm"></i>
                    </a>
                </div>
            </div>

            <div class="relative">
                <div class="relative max-w-2xl mx-auto animate-float">
                    <Image src={image1} alt="Fresh Oyster Mushrooms" class="w-full rounded-3xl" widths={[480, 768, 960]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 50vw, 640px" loading="eager" fetchpriority="high" quality={72} />
                </div>
                <div class="absolute top-10 right-10 w-20 h-20 bg-primary-light rounded-full -z-10"></div>
                <div class="absolute bottom-10 left-10 w-32 h-32 bg-primary-light rounded-full -z-10"></div>
            </div>
        </div>
    </div>
</section>

<!-- Hook / Value Proposition Section -->
<section class="py-12 bg-primary text-white overflow-hidden relative">
    <div class="absolute top-0 left-0 right-0 h-full opacity-10 pointer-events-none overflow-hidden flex items-center">
        <div class="whitespace-nowrap animate-marquee text-9xl font-bold uppercase tracking-widest text-white">
            Superfood - Protein - Immunity - Energy - Superfood - Protein - Immunity - Energy
        </div>
    </div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <span class="inline-block py-1 px-3 rounded-full bg-primary-light text-primary text-xs font-bold uppercase tracking-wider mb-4 animate-bounce">Limited Daily Harvest</span>
        <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
            <span>Have You Tasted the "Vegetarian Meat"?</span>
        </h2>
        <p class="text-xl md:text-2xl text-white/90 mb-8 font-light max-w-3xl mx-auto">
            <span>Tastes like meat. Nature's functional food. Vadakara's new health secret!</span>
        </p>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto border-t border-white/20 pt-8 mt-8">
            <div class="text-center">
                <div class="text-3xl mb-2"><i class="fas fa-bolt text-stone-200"></i></div>
                <div class="font-bold text-lg">Metabolism</div>
                <div class="text-xs text-white/80">B-Vitamin Boost</div>
            </div>
             <div class="text-center">
                <div class="text-3xl mb-2"><i class="fas fa-shield-alt text-stone-200"></i></div>
                <div class="font-bold text-lg">Immunity Boost</div>
                <div class="text-xs text-white/80">Beta-Glucans</div>
            </div>
             <div class="text-center">
                <div class="text-3xl mb-2"><i class="fas fa-brain text-stone-200"></i></div>
                <div class="font-bold text-lg">Brain Power</div>
                <div class="text-xs text-white/80">Neuro-protective</div>
            </div>
             <div class="text-center">
                <div class="text-3xl mb-2"><i class="fas fa-heart text-stone-200"></i></div>
                <div class="font-bold text-lg">Heart Health</div>
                <div class="text-xs text-white/80">Zero Cholesterol</div>
            </div>
        </div>
    </div>
</section>

<!-- Store Section -->
<section id="store" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Our Store</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Our Farm Fresh Products</h2>
            <p class="text-stone-600">Select your items below. Fast checkout via WhatsApp.</p>
        </div>

        <!-- How to Order Teaser -->
        <div class="bg-primary-light rounded-2xl p-6 mb-12 text-center border border-primary/10">
            <div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto">
                <div class="flex items-center gap-3 justify-center">
                    <span class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-bold text-sm">1</span>
                    <span class="text-sm font-medium text-stone-700">Add items to cart</span>
                </div>
                <div class="flex items-center gap-3 justify-center">
                    <span class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-bold text-sm">2</span>
                    <span class="text-sm font-medium text-stone-700">Enter delivery details</span>
                </div>
                <div class="flex items-center gap-3 justify-center">
                    <span class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-bold text-sm">3</span>
                    <span class="text-sm font-medium text-stone-700">Order on WhatsApp</span>
                </div>
            </div>
        </div>

        <!-- All Products in Single Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {products.map((product) => <ProductCard product={product} />)}
        </div>
    </div>
</section>

<!-- Cooking Videos Section -->
<section id="videos" class="py-20 bg-[#F8FAF8]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Learn to Cook</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Learn to Cook in Minutes</h2>
            <p class="text-stone-600">Oysters hold their shape and absorb traditional Kerala curry flavors perfectly.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {cookingVideos.map((video) => (
                <div class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all group">
                    <div class="relative">
                        <img src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`} alt={video.title} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                        <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <i class="fas fa-play text-white text-3xl"></i>
                        </div>
                        <span class="absolute top-4 left-4 bg-red-600 text-white text-xs px-2 py-1 rounded" data-ml={video.label}>{video.label}</span>
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-semibold text-stone-900 mb-2" data-ml={video.titleML || video.title}>{video.title}</h3>
                        <p class="text-stone-600 text-sm mb-4">{video.description}</p>
                        <a href={`https://youtube.com/watch?v=${video.id}`} target="_blank" class="inline-flex items-center gap-2 text-primary font-medium hover:text-primary-dark transition-colors">
                            <span>Watch on YouTube</span>
                            <i class="fas fa-external-link-alt text-sm"></i>
                        </a>
                    </div>
                </div>
            ))}
        </div>

        <div class="text-center mt-12">
            <a href="/cooking-videos" class="inline-flex items-center gap-2 px-8 py-4 bg-red-600 text-white rounded-full hover:bg-red-700 transition-all group">
                <i class="fab fa-youtube"></i>
                <span>More Cooking Videos</span>
                <i class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- Condensed Health Benefits -->
<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Health Benefits</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">
                <span>Discover the Benefits of Oyster Mushrooms</span>
            </h2>
            <p class="text-stone-600 mb-4">Packed with nutrition and scientifically proven health benefits.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">

            <!-- 1. Immune System Support -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10 hover:shadow-lg transition-all group text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors">
                    <i class="fas fa-shield-virus text-2xl text-primary group-hover:text-white"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-3">Immune System Support</h3>
                <p class="text-stone-600 text-sm leading-relaxed">
                    Rich in naturally occurring beta-glucans that help support healthy immune function.
                </p>
            </div>

            <!-- 2. High in Protein -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10 hover:shadow-lg transition-all group text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors">
                    <i class="fas fa-dumbbell text-2xl text-primary group-hover:text-white"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-3">High in Protein</h3>
                <p class="text-stone-600 text-sm leading-relaxed">
                    A great plant-based protein source for everyday nutrition and muscle recovery.
                </p>
            </div>

            <!-- 3. Naturally Rich in Vitamin D -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10 hover:shadow-lg transition-all group text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors">
                    <i class="fas fa-sun text-2xl text-primary group-hover:text-white"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-3">Naturally Rich in Vitamin D</h3>
                <p class="text-stone-600 text-sm leading-relaxed">
                    One of the few natural food sources that can provide Vitamin D when exposed to sunlight.
                </p>
            </div>

            <!-- 4. Heart-Friendly Nutrition -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10 hover:shadow-lg transition-all group text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors">
                    <i class="fas fa-heart text-2xl text-primary group-hover:text-white"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-3">Heart-Friendly Nutrition</h3>
                <p class="text-stone-600 text-sm leading-relaxed">
                    Contains compounds that may help support healthy cholesterol levels and heart wellness.
                </p>
            </div>

            <!-- 5. Supports Brain Health -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10 hover:shadow-lg transition-all group text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors">
                    <i class="fas fa-brain text-2xl text-primary group-hover:text-white"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-3">Supports Brain Health</h3>
                <p class="text-stone-600 text-sm leading-relaxed">
                    Contains antioxidants and bioactive compounds linked to cognitive and nerve health.
                </p>
            </div>

            <!-- 6. Gut Health & Digestion -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10 hover:shadow-lg transition-all group text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors">
                    <i class="fas fa-seedling text-2xl text-primary group-hover:text-white"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-3">Gut Health & Digestion</h3>
                <p class="text-stone-600 text-sm leading-relaxed">
                    Rich in dietary fiber that helps support digestion and a healthy gut microbiome.
                </p>
            </div>

            <!-- 7. Low-Calorie Superfood -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10 hover:shadow-lg transition-all group text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors">
                    <i class="fas fa-weight text-2xl text-primary group-hover:text-white"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-3">Low-Calorie Superfood</h3>
                <p class="text-stone-600 text-sm leading-relaxed">
                    Nutrient-dense, low in calories, and ideal for healthy everyday meals.
                </p>
            </div>

            <!-- 8. Antioxidant Rich -->
            <div class="bg-[#F8FAF8] rounded-2xl p-8 border border-primary/10 hover:shadow-lg transition-all group text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors">
                    <i class="fas fa-shield text-2xl text-primary group-hover:text-white"></i>
                </div>
                <h3 class="text-xl font-bold text-stone-900 mb-3">Antioxidant Rich</h3>
                <p class="text-stone-600 text-sm leading-relaxed">
                    Packed with antioxidants that help the body fight oxidative stress naturally.
                </p>
            </div>

        </div>
    </div>
</section>

<!-- Conversion FAQ -->
<section class="py-16 bg-stone-50 border-y border-stone-200" id="faq-section">
    <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-10">
            <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider mb-3">No Hesitation</span>
            <h2 class="text-3xl font-bold text-stone-900 mb-4">First Time Buying?</h2>
            <p class="text-stone-600 max-w-2xl mx-auto">We answer your top questions so you can order with confidence.</p>
        </div>

        <div class="space-y-3">
            <!-- Q1: Delivery Area -->
            <details class="group bg-white rounded-xl border border-stone-200 overflow-hidden open:shadow-md open:border-primary/20 transition-all duration-300">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-stone-50 transition-colors">
                    <h3 class="font-bold text-lg text-stone-900 flex items-center gap-3">
                        <span class="w-8 h-8 bg-primary/10 text-primary rounded-full flex items-center justify-center text-sm"><i class="fas fa-truck"></i></span>
                        <span>Where do you deliver?</span>
                    </h3>
                    <span class="text-stone-400 group-open:rotate-180 transition-transform duration-300">
                        <i class="fas fa-chevron-down"></i>
                    </span>
                </summary>
                <div class="px-5 pb-5 pt-0 text-stone-600 leading-relaxed border-t border-transparent group-open:border-stone-100 group-open:pt-4">
                    <p>We deliver fresh harvests locally across the <strong>Vadakara and Kozhikode</strong> area to ensure maximum freshness.</p>
                </div>
            </details>

            <!-- Q2: Freshness -->
            <details class="group bg-white rounded-xl border border-stone-200 overflow-hidden open:shadow-md open:border-primary/20 transition-all duration-300">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-stone-50 transition-colors">
                    <h3 class="font-bold text-lg text-stone-900 flex items-center gap-3">
                        <span class="w-8 h-8 bg-primary/10 text-primary rounded-full flex items-center justify-center text-sm"><i class="fas fa-clock"></i></span>
                        <span>How long do they stay fresh?</span>
                    </h3>
                    <span class="text-stone-400 group-open:rotate-180 transition-transform duration-300">
                        <i class="fas fa-chevron-down"></i>
                    </span>
                </summary>
                <div class="px-5 pb-5 pt-0 text-stone-600 leading-relaxed border-t border-transparent group-open:border-stone-100 group-open:pt-4">
                    <p>Store them in your refrigerator (2-4<span>°C</span>) in their original breathable packaging, and they will stay perfectly fresh for up to <strong>4 days</strong>.</p>
                </div>
            </details>
            
            <!-- Q3: Washing -->
            <details class="group bg-white rounded-xl border border-stone-200 overflow-hidden open:shadow-md open:border-primary/20 transition-all duration-300">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-stone-50 transition-colors">
                    <h3 class="font-bold text-base text-stone-900 flex items-center gap-2">
                        <span class="w-8 h-8 bg-primary/10 text-primary rounded-full flex items-center justify-center text-sm"><i class="fas fa-hand-holding-water"></i></span>
                        <span>Do I need to wash them?</span>
                    </h3>
                    <span class="text-stone-400 group-open:rotate-180 transition-transform duration-300">
                        <i class="fas fa-chevron-down"></i>
                    </span>
                </summary>
                <div class="px-5 pb-5 pt-0 text-stone-600 leading-relaxed border-t border-transparent group-open:border-stone-100 group-open:pt-4">
                    <p><strong>Do not soak them.</strong> Simply wipe them with a damp cloth or give them a very gentle, quick rinse under cold water right before cooking.</p>
                </div>
            </details>

            <!-- Q4: Texture -->
            <details class="group bg-white rounded-xl border border-stone-200 overflow-hidden open:shadow-md open:border-primary/20 transition-all duration-300">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-stone-50 transition-colors">
                    <h3 class="font-bold text-base text-stone-900 flex items-center gap-2">
                        <span class="w-8 h-8 bg-primary/10 text-primary rounded-full flex items-center justify-center text-sm"><i class="fas fa-utensils"></i></span>
                        <span>What is the texture like?</span>
                    </h3>
                    <span class="text-stone-400 group-open:rotate-180 transition-transform duration-300">
                        <i class="fas fa-chevron-down"></i>
                    </span>
                </summary>
                <div class="px-5 pb-5 pt-0 text-stone-600 leading-relaxed border-t border-transparent group-open:border-stone-100 group-open:pt-4">
                    <p>Unlike common button mushrooms that shrink and get soggy, our oyster mushrooms maintain a firm, satisfying <strong>"meaty" bite</strong> even in heavy curries.</p>
                </div>
            </details>
        </div>
        
        <div class="mt-8 text-center">
            <a href="https://wa.me/918078937260" target="_blank" class="hover:underline inline-flex items-center justify-center gap-1 text-sm text-stone-500">
                <i class="fab fa-whatsapp text-green-600"></i>
                <span>Still have questions? Ask us on WhatsApp</span>
            </a>
        </div>
    </div>
</section>

<!-- Safety, Quality & Why Choose Us -->
<section id="safety" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <!-- Grown Safely in Kerala -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-sm font-medium text-primary tracking-wider uppercase block mb-3">Safety & Quality</span>
            <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">Grown Safely in Kerala</h2>
            <p class="text-stone-600">Our commitment to quality and safety standards you can trust.</p>
        </div>

        <!-- Registration Badges -->
        <div class="grid md:grid-cols-2 gap-8 mb-16">
            <div class="bg-[#F8FAF8] rounded-2xl p-8 text-center hover:shadow-xl transition-all duration-300 border border-primary/10">
                <div class="w-20 h-20 bg-primary/5 rounded-full flex items-center justify-center mx-auto mb-6">
